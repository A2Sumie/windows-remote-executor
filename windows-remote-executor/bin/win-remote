#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=../lib/common.sh
source "${TOOL_ROOT}/lib/common.sh"

usage() {
  cat <<'EOF'
Usage:
  win-remote exec <target> [--cwd <remote-dir>] [--shell <powershell|cmd>] [--file <local-script> | --stdin | <script-code>]
  win-remote exec-capture <target> [--cwd <remote-dir>] [--shell <powershell|cmd>] [--out <local-json-file>] [--file <local-script> | --stdin | <script-code>]
  win-remote cmd <target> <cmd-code>
  win-remote run <target> [--cwd <remote-dir>] [--allow-powershell] <program> [args...]
  win-remote capture <target> [--cwd <remote-dir>] [--out <local-json-file>] [--allow-powershell] [--cmd <cmd-code> | <program> [args...]]
  win-remote spawn <target> [--cwd <remote-dir>] [--stdout <remote-log>] [--stderr <remote-log>] [--out <local-json-file>] [--allow-powershell] <program> [args...]
  win-remote wsl <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--heartbeat-seconds <n>] <program> [args...]
  win-remote wsl-capture <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--out <local-json-file>] [--heartbeat-seconds <n>] <program> [args...]
  win-remote wsl-py <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--python <linux-python>] [--heartbeat-seconds <n>] [--module <module> | <script-path>] [-- <script-args...>]
  win-remote wsl-py-capture <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--python <linux-python>] [--out <local-json-file>] [--heartbeat-seconds <n>] [--module <module> | <script-path>] [-- <script-args...>]
  win-remote wsl-sh <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--shell <linux-shell>] [--heartbeat-seconds <n>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]
  win-remote wsl-sh-capture <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--shell <linux-shell>] [--out <local-json-file>] [--heartbeat-seconds <n>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]
  win-remote wsl-container-sh <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] --container <name> [--container-runtime <docker|podman|path>] [--container-cwd <dir>] [--container-user <user>] [--container-shell <shell>] [--heartbeat-seconds <n>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]
  win-remote wsl-container-sh-capture <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] --container <name> [--container-runtime <docker|podman|path>] [--container-cwd <dir>] [--container-user <user>] [--container-shell <shell>] [--out <local-json-file>] [--heartbeat-seconds <n>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]
  win-remote wsl-resident <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--shell <linux-shell>] [--pid-file <linux-path>] [--log-file <linux-path>] [--port <n>] [--health-url <url>] [--ready-timeout <seconds>] [--settle-delay <seconds>] [--poll-interval-ms <n>] [--diag-lines <n>] [--out <local-json-file>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]
  win-remote py <target> <remote-script-path> [--cwd <remote-dir>] [--python <remote-python>] [--conda-env <name> | --conda-prefix <prefix>] [-- <script-args...>]
  win-remote find <target> <query> [--max <count>]
  win-remote probe|ping <target> [--out <local-json-file>]
  win-remote guard <target> [--out <local-json-file>] [--no-disable] [--expected-listen-address <ip>]
  win-remote repair <target> [--out <local-json-file>] [--expected-listen-address <ip>] [--force-rewrite]
  win-remote tasks <target> [--task-name <name>]... [--prefix <text>] [--out <local-json-file>]
  win-remote policy <target> [--mode <private-only|public-with-token>] [--command-mode <standard|argv-only>] [--expected-listen-address <ip>] [--label <text>] [--token <plain-token> | --rotate-token] [--skip-guard-install] [--no-run-guard]
  win-remote update-tools <target> [--native-dir <local-dir> | --native-exe <local-exe> | --native-zip <release-asset.zip>] [--everything-dll <local-dll>] [--es-exe <local-es>] [--policy-file <local-json>] [--install-guard]
  win-remote put <target> <local-path> <remote-path>
  win-remote get <target> <remote-path> <local-path>
  win-remote deploy <target> <local-dir> <remote-dir> [--post <powershell-code> | --post-file <local-ps1> | --post-stdin]
  win-remote ps-encode [--file <local-ps1> | --stdin | <powershell-code>]
  win-remote ps-decode <utf8-base64>
  win-remote ps-check [--file <local-ps1> | --stdin | <powershell-code>]
  win-remote help

Target resolution:
  <target> can be either:
  - a target name mapped to <project-root>/targets/<name>.env
  - an explicit path to a .env file
EOF
}

default_native_publish_dir() {
  local candidate
  for candidate in \
    "${TOOL_ROOT}/../windows-remote-executor-native/publish/fdd-win-x64" \
    "${TOOL_ROOT}/../windows-remote-executor-native/publish/scd-win-x64" \
    "${TOOL_ROOT}/../windows-remote-executor-native/publish/win-x64"
  do
    if [[ -f "${candidate}/WindowsRemoteExecutor.Native.exe" ]]; then
      printf '%s' "${candidate}"
      return
    fi
  done

  die "No local native publish output found. Build or publish windows-remote-executor-native first."
}

default_local_es_exe() {
  local candidate="${TOOL_ROOT}/../windows-remote-executor-native/third_party/everything-cli/es.exe"
  [[ -f "${candidate}" ]] || return 1
  printf '%s' "${candidate}"
}

resolve_expected_listen_address() {
  local override="${1:-}"

  if [[ -n "${override}" ]]; then
    is_ipv4_literal "${override}" || die "Expected listen address must be an IPv4 literal: ${override}"
    printf '%s' "${override}"
    return
  fi

  if [[ -n "${TARGET_EXPECTED_LISTEN_ADDRESS}" ]]; then
    is_ipv4_literal "${TARGET_EXPECTED_LISTEN_ADDRESS}" || die "TARGET_EXPECTED_LISTEN_ADDRESS must be an IPv4 literal: ${TARGET_EXPECTED_LISTEN_ADDRESS}"
    printf '%s' "${TARGET_EXPECTED_LISTEN_ADDRESS}"
    return
  fi

  if is_ipv4_literal "${TARGET_HOST}"; then
    printf '%s' "${TARGET_HOST}"
    return
  fi

  die "Expected listen address is required. Set TARGET_EXPECTED_LISTEN_ADDRESS or pass --expected-listen-address."
}

default_policy_label() {
  local mode="$1"
  local token="$2"

  if [[ -n "${TARGET_POLICY_LABEL}" ]]; then
    printf '%s' "${TARGET_POLICY_LABEL}"
    return
  fi

  case "${mode}" in
    private-only)
      if [[ -n "${token}" ]]; then
        printf 'PRIVATE-ONLY TOKEN-REQUIRED'
      else
        printf 'PRIVATE-ONLY'
      fi
      ;;
    public-with-token)
      printf 'PUBLIC-WITH-TOKEN EXPLICIT'
      ;;
    *)
      die "Unsupported exposure mode: ${mode}"
      ;;
  esac
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "${value}"
}

upsert_env_var() {
  local env_file="$1"
  local key="$2"
  local value="$3"
  local rendered_value
  rendered_value="$(printf '%q' "${value}")"
  local tmp_file
  tmp_file="$(mktemp)"
  local found=0

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" == "${key}="* ]]; then
      printf '%s=%s\n' "${key}" "${rendered_value}" >>"${tmp_file}"
      found=1
    else
      printf '%s\n' "${line}" >>"${tmp_file}"
    fi
  done <"${env_file}"

  if [[ ${found} -eq 0 ]]; then
    printf '%s=%s\n' "${key}" "${rendered_value}" >>"${tmp_file}"
  fi

  mv "${tmp_file}" "${env_file}"
}

write_policy_file() {
  local output_path="$1"
  local expected_listen_address="$2"
  local exposure_mode="$3"
  local command_mode="$4"
  local label="$5"
  local access_token="$6"
  local access_token_sha256=""
  local access_token_json="null"

  if [[ -n "${access_token}" ]]; then
    access_token_sha256="$(sha256_hex "${access_token}")"
    access_token_json="\"${access_token_sha256}\""
  fi

  cat >"${output_path}" <<EOF
{
  "expectedListenAddress": "$(json_escape "${expected_listen_address}")",
  "exposureMode": "$(json_escape "${exposure_mode}")",
  "commandMode": "$(json_escape "${command_mode}")",
  "label": "$(json_escape "${label}")",
  "accessTokenSha256": ${access_token_json},
  "updatedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
}

install_guard_tasks() {
  local expected_listen_address="$1"
  local guard_script_path="${TARGET_TOOLS_DIR}/codex-sshd-guard.cmd"
  local local_script
  local remote_script

  local_script="$(mktemp)"
  cat >"${local_script}" <<EOF
@echo off
setlocal EnableExtensions EnableDelayedExpansion
set "WINDOWS_REMOTE_EXECUTOR_PRIMARY=$(remote_cmd_path "${TARGET_NATIVE_LAUNCHER}")"
set "WINDOWS_REMOTE_EXECUTOR_FALLBACK=$(remote_cmd_path "${TARGET_NATIVE_EXE}")"
if exist "%WINDOWS_REMOTE_EXECUTOR_PRIMARY%" (
  call "%WINDOWS_REMOTE_EXECUTOR_PRIMARY%" guard-sshd --expected-listen-address ${expected_listen_address} --log-path "$(remote_cmd_path "${TARGET_GUARD_LOG_PATH}")"
  exit /b !ERRORLEVEL!
)
if exist "%WINDOWS_REMOTE_EXECUTOR_FALLBACK%" (
  "%WINDOWS_REMOTE_EXECUTOR_FALLBACK%" guard-sshd --expected-listen-address ${expected_listen_address} --log-path "$(remote_cmd_path "${TARGET_GUARD_LOG_PATH}")"
  exit /b !ERRORLEVEL!
)
echo error: WindowsRemoteExecutor native payload not found. 1>&2
exit /b 127
EOF

  remote_script="$(normalize_remote_path "${guard_script_path}")"
  ensure_remote_parent "${remote_script}"
  scp_to_remote "${local_script}" "${remote_script}"
  rm -f "${local_script}"

  local guard_script_cmd
  guard_script_cmd="$(remote_cmd_path "${guard_script_path}")"

  ssh_exec_cmd "schtasks /Create /TN \"CodexRemote Sshd Guard Startup\" /SC ONSTART /RU SYSTEM /TR \"\\\"${guard_script_cmd}\\\"\" /F && schtasks /Create /TN \"CodexRemote Sshd Guard Watch\" /SC MINUTE /MO 5 /RU SYSTEM /TR \"\\\"${guard_script_cmd}\\\"\" /F && schtasks /Run /TN \"CodexRemote Sshd Guard Watch\""
}

ssh_exec_powershell() {
  local code="$1"
  local temp_dir
  temp_dir="$(mktemp -d)"
  local local_script_path="${temp_dir}/payload.ps1"
  printf '%s' "${code}" >"${local_script_path}"

  local status=0
  if invoke_exec_file_bridge "run" "powershell" "" "${local_script_path}"; then
    status=0
  else
    status=$?
  fi

  cleanup_exec_source_best_effort "${temp_dir}"

  if [[ ${status} -eq 127 ]]; then
    die "PowerShell execution now requires ${TARGET_NATIVE_EXE} on the remote host."
  fi

  return "${status}"
}

ssh_exec_cmd() {
  local code="$1"
  ssh_raw "${TARGET_USER}@${TARGET_HOST}" "cmd.exe /d /s /c \"${code}\""
}

read_text_source() {
  local command_name="$1"
  shift

  case "${1:-}" in
    --file)
      [[ $# -eq 2 ]] || die "${command_name} --file requires exactly one local file path"
      [[ -f "$2" ]] || die "Local file not found: $2"
      cat "$2"
      ;;
    --stdin)
      [[ $# -eq 1 ]] || die "${command_name} --stdin does not accept extra arguments"
      cat
      ;;
    "")
      die "${command_name} requires inline PowerShell, --file <local-ps1>, or --stdin"
      ;;
    *)
      printf '%s' "$*"
      ;;
  esac
}

is_raw_powershell_program() {
  local program="${1//\\//}"
  program="${program##*/}"
  program="$(printf '%s' "${program}" | tr '[:upper:]' '[:lower:]')"

  case "${program}" in
    powershell|powershell.exe|pwsh|pwsh.exe)
      return 0
      ;;
  esac

  return 1
}

guard_raw_powershell_program() {
  local subcommand="$1"
  local allow_flag="$2"
  local program="$3"

  [[ "${allow_flag}" == "1" ]] && return 0
  [[ "${WIN_REMOTE_ALLOW_RAW_POWERSHELL:-0}" == "1" ]] && return 0

  if is_raw_powershell_program "${program}"; then
    die "${subcommand} blocks raw PowerShell transport by default: ${program}. Use 'win-remote exec <target> --file <script.ps1>' or 'win-remote exec <target> --stdin'. If you intentionally need the legacy path, pass --allow-powershell."
  fi
}

print_ok() {
  printf 'OK\n'
}

cmd_quote() {
  local value="${1//\"/\"\"}"
  printf '"%s"' "${value}"
}

path_requires_cmd_call() {
  local program="${1//\\//}"
  program="$(printf '%s' "${program}" | tr '[:upper:]' '[:lower:]')"
  case "${program}" in
    *.cmd|*.bat)
      return 0
      ;;
  esac
  return 1
}

build_native_invoke_body() {
  local remote_path="$1"
  shift

  local remote_path_cmd
  remote_path_cmd="$(remote_cmd_path "${remote_path}")"

  local prefix=""
  if path_requires_cmd_call "${remote_path}"; then
    prefix="call "
  fi

  local code="${prefix}\"${remote_path_cmd}\""
  local token
  for token in "$@"; do
    code+=" $(cmd_quote "${token}")"
  done
  code+=" & exit /b !ERRORLEVEL!"
  printf '%s' "${code}"
}

build_native_invoke_code() {
  local remote_path="$1"
  shift

  local remote_path_cmd
  remote_path_cmd="$(remote_cmd_path "${remote_path}")"
  local body
  body="$(build_native_invoke_body "${remote_path}" "$@")"
  printf 'if exist "%s" (%s) else (exit /b 127)' "${remote_path_cmd}" "${body}"
}

remote_current_release_dir_best_effort() {
  local current_release_file_cmd
  current_release_file_cmd="$(remote_cmd_path "${TARGET_NATIVE_CURRENT_FILE}")"

  local output
  if ! output="$(ssh_exec_cmd "if exist \"${current_release_file_cmd}\" type \"${current_release_file_cmd}\"" 2>/dev/null)"; then
    return 1
  fi

  local first_line
  first_line="$(printf '%s\n' "${output}" | tr -d '\r' | awk 'NF { print; exit }')"
  [[ -n "${first_line}" ]] || return 1

  normalize_remote_path "${first_line}"
}

remote_file_exists_best_effort() {
  local remote_path
  remote_path="$(normalize_remote_path "$1")"
  local remote_path_cmd
  remote_path_cmd="$(remote_cmd_path "${remote_path}")"

  ssh_exec_cmd "if exist \"${remote_path_cmd}\" (exit /b 0) else (exit /b 1)" >/dev/null 2>&1
}

json_array_from_values() {
  local rendered="["
  local first=1
  local value
  for value in "$@"; do
    if [[ ${first} -eq 0 ]]; then
      rendered+=","
    fi
    rendered+="\"$(json_escape "${value}")\""
    first=0
  done
  rendered+="]"
  printf '%s' "${rendered}"
}

remote_windows_path_to_wsl() {
  local remote_path
  remote_path="$(normalize_remote_path "$1")"

  if [[ ! "${remote_path}" =~ ^([A-Za-z]):(/.*)?$ ]]; then
    die "Cannot translate non-drive Windows path to WSL: ${remote_path}"
  fi

  local drive="${BASH_REMATCH[1]}"
  drive="$(printf '%s' "${drive}" | tr '[:upper:]' '[:lower:]')"
  local remainder="${BASH_REMATCH[2]:-}"
  printf '/mnt/%s%s' "${drive}" "${remainder}"
}

generate_stage_id() {
  printf '%s-%s-%04x' "$(date +%Y%m%d-%H%M%S)" "$$" "$((RANDOM & 0xffff))"
}

validate_positive_integer() {
  local value="$1"
  local label="$2"
  [[ "${value}" =~ ^[1-9][0-9]*$ ]] || die "${label} must be a positive integer"
}

render_wsl_heartbeat_wrapper() {
  cat <<'EOF'
set -eu
heartbeat_seconds="$1"
program="$2"
shift 2
heartbeat_loop() {
  local child_pid="$1"
  local interval="$2"
  while kill -0 "${child_pid}" 2>/dev/null; do
    printf '[win-remote] heartbeat pid=%s utc=%s\n' "${child_pid}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
    sleep "${interval}"
  done
}
"${program}" "$@" &
child_pid="$!"
heartbeat_loop "${child_pid}" "${heartbeat_seconds}" &
heartbeat_pid="$!"
set +e
wait "${child_pid}"
status="$?"
set -e
kill "${heartbeat_pid}" 2>/dev/null || true
wait "${heartbeat_pid}" 2>/dev/null || true
exit "${status}"
EOF
}

render_wsl_stage_bootstrap() {
  local heartbeat_seconds="${1:-0}"

  if [[ "${heartbeat_seconds}" == "0" ]]; then
    cat <<'EOF'
set -eu
src="$1"
dst="$2"
shell_path="$3"
shift 3
cleanup() {
  rm -f "$dst"
}
trap cleanup EXIT
cp "$src" "$dst"
chmod 700 "$dst"
"$shell_path" "$dst" "$@"
EOF
    return
  fi

  cat <<'EOF'
set -eu
src="$1"
dst="$2"
shell_path="$3"
heartbeat_seconds="$4"
shift 4
cleanup() {
  rm -f "$dst"
}
trap cleanup EXIT
cp "$src" "$dst"
chmod 700 "$dst"
heartbeat_loop() {
  local child_pid="$1"
  local interval="$2"
  while kill -0 "${child_pid}" 2>/dev/null; do
    printf '[win-remote] heartbeat pid=%s utc=%s\n' "${child_pid}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
    sleep "${interval}"
  done
}
"$shell_path" "$dst" "$@" &
child_pid="$!"
heartbeat_loop "${child_pid}" "${heartbeat_seconds}" &
heartbeat_pid="$!"
set +e
wait "${child_pid}"
status="$?"
set -e
kill "${heartbeat_pid}" 2>/dev/null || true
wait "${heartbeat_pid}" 2>/dev/null || true
exit "${status}"
EOF
}

render_wsl_container_stage_bootstrap() {
  local heartbeat_seconds="${1:-0}"

  if [[ "${heartbeat_seconds}" == "0" ]]; then
    cat <<'EOF'
set -euo pipefail
src="$1"
dst="$2"
runtime="$3"
container="$4"
container_shell="$5"
container_cwd="$6"
container_user="$7"
shift 7
cleanup() {
  rm -f "$dst"
}
trap cleanup EXIT
cp "$src" "$dst"
chmod 600 "$dst"
container_args=(exec -i)
if [[ -n "$container_cwd" ]]; then
  container_args+=(--workdir "$container_cwd")
fi
if [[ -n "$container_user" ]]; then
  container_args+=(--user "$container_user")
fi
container_args+=("$container" "$container_shell" -s --)
"$runtime" "${container_args[@]}" "$@" <"$dst"
EOF
    return
  fi

  cat <<'EOF'
set -euo pipefail
src="$1"
dst="$2"
runtime="$3"
container="$4"
container_shell="$5"
container_cwd="$6"
container_user="$7"
heartbeat_seconds="$8"
shift 8
cleanup() {
  rm -f "$dst"
}
trap cleanup EXIT
cp "$src" "$dst"
chmod 600 "$dst"
container_args=(exec -i)
if [[ -n "$container_cwd" ]]; then
  container_args+=(--workdir "$container_cwd")
fi
if [[ -n "$container_user" ]]; then
  container_args+=(--user "$container_user")
fi
container_args+=("$container" "$container_shell" -s --)
run_container() {
  "$runtime" "${container_args[@]}" "$@" <"$dst"
}
heartbeat_loop() {
  local child_pid="$1"
  local interval="$2"
  while kill -0 "${child_pid}" 2>/dev/null; do
    printf '[win-remote] container heartbeat pid=%s container=%s utc=%s\n' "${child_pid}" "${container}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
    sleep "${interval}"
  done
}
run_container "$@" &
child_pid="$!"
heartbeat_loop "${child_pid}" "${heartbeat_seconds}" &
heartbeat_pid="$!"
set +e
wait "${child_pid}"
status="$?"
set -e
kill "${heartbeat_pid}" 2>/dev/null || true
wait "${heartbeat_pid}" 2>/dev/null || true
exit "${status}"
EOF
}

cleanup_remote_dir_best_effort() {
  local remote_dir
  remote_dir="$(normalize_remote_path "$1")"
  if ssh_exec_native_tokens "delete-tree-b64" "--path" "$(encode_utf8_b64 "${remote_dir}")" >/dev/null 2>&1; then
    return
  fi

  local remote_dir_cmd
  remote_dir_cmd="$(remote_cmd_path "${remote_dir}")"
  ssh_raw "${TARGET_USER}@${TARGET_HOST}" "cmd.exe /d /s /c \"if exist \"\"${remote_dir_cmd}\"\" rmdir /s /q \"\"${remote_dir_cmd}\"\"\"" >/dev/null 2>&1 || true
}

remote_native_supports_command() {
  local command_name="$1"
  local help_output=""
  if ! help_output="$(ssh_exec_native_tokens help 2>/dev/null)"; then
    return 2
  fi

  if printf '%s\n' "${help_output}" | grep -F -- "${command_name}" >/dev/null; then
    return 0
  fi

  return 1
}

remote_native_support_status() {
  local command_name="$1"
  if [[ "${WIN_REMOTE_FORCE_EXEC_FALLBACK:-0}" == "1" && "${command_name}" == exec-file-* ]]; then
    return 1
  fi

  remote_native_supports_command "${command_name}"
}

warn_compat_route() {
  printf 'warning: %s\n' "$*" >&2
}

cleanup_wsl_stage_best_effort() {
  local cleanup_local_script="$1"
  local local_script_path="$2"
  local remote_stage_dir="${3:-}"

  if [[ "${cleanup_local_script}" == "1" && -n "${local_script_path}" ]]; then
    rm -f "${local_script_path}" || true
  fi

  if [[ -n "${remote_stage_dir}" ]]; then
    cleanup_remote_dir_best_effort "${remote_stage_dir}"
  fi
}

normalize_exec_kind() {
  local kind="$1"
  kind="$(printf '%s' "${kind}" | tr '[:upper:]' '[:lower:]')"
  case "${kind}" in
    ps|powershell)
      printf 'powershell'
      ;;
    cmd|batch)
      printf 'cmd'
      ;;
    *)
      die "Unsupported exec shell: ${kind}. Use powershell or cmd."
      ;;
  esac
}

exec_payload_suffix() {
  case "$1" in
    powershell)
      printf 'ps1'
      ;;
    cmd)
      printf 'cmd'
      ;;
    *)
      die "Unsupported exec payload kind: $1"
      ;;
  esac
}

prepare_exec_source_file() {
  local command_name="$1"
  local kind="$2"
  shift 2

  PREPARED_EXEC_SOURCE_FILE=""
  PREPARED_EXEC_CLEANUP_DIR=""

  local suffix
  suffix="$(exec_payload_suffix "${kind}")"

  case "${1:-}" in
    --file)
      [[ $# -eq 2 ]] || die "${command_name} --file requires exactly one local file path"
      [[ -f "$2" ]] || die "Local file not found: $2"
      PREPARED_EXEC_SOURCE_FILE="$2"
      ;;
    --stdin)
      [[ $# -eq 1 ]] || die "${command_name} --stdin does not accept extra arguments"
      PREPARED_EXEC_CLEANUP_DIR="$(mktemp -d)"
      PREPARED_EXEC_SOURCE_FILE="${PREPARED_EXEC_CLEANUP_DIR}/payload.${suffix}"
      cat >"${PREPARED_EXEC_SOURCE_FILE}"
      ;;
    "")
      die "${command_name} requires inline script, --file <local-script>, or --stdin"
      ;;
    *)
      PREPARED_EXEC_CLEANUP_DIR="$(mktemp -d)"
      PREPARED_EXEC_SOURCE_FILE="${PREPARED_EXEC_CLEANUP_DIR}/payload.${suffix}"
      printf '%s' "$*" >"${PREPARED_EXEC_SOURCE_FILE}"
      ;;
  esac
}

cleanup_exec_source_best_effort() {
  local cleanup_dir="${1:-}"
  if [[ -n "${cleanup_dir}" ]]; then
    rm -rf "${cleanup_dir}" || true
  fi
}

invoke_exec_file_bridge() {
  local mode="$1"
  local kind="$2"
  local cwd="$3"
  local local_script_path="$4"

  local stage_id
  stage_id="$(generate_stage_id)"
  local remote_stage_dir="${TARGET_STAGE_ROOT}/exec-bridge-${stage_id}"
  local suffix
  suffix="$(exec_payload_suffix "${kind}")"
  local remote_stage_path="${remote_stage_dir}/payload.${suffix}"

  local native_command="exec-file-b64"
  if [[ "${mode}" == "capture" ]]; then
    native_command="exec-file-capture-b64"
  elif [[ "${mode}" != "run" ]]; then
    die "Unsupported exec bridge mode: ${mode}"
  fi

  local native_bridge_supported=1
  if remote_native_support_status "${native_command}"; then
    native_bridge_supported=1
  else
    case "$?" in
      1)
        native_bridge_supported=0
        ;;
      *)
        native_bridge_supported=1
        ;;
    esac
  fi

  local setup_status=0
  if ensure_remote_dir "${remote_stage_dir}"; then
    :
  else
    setup_status=$?
    cleanup_remote_dir_best_effort "${remote_stage_dir}"
    return "${setup_status}"
  fi
  if scp_to_remote "${local_script_path}" "${remote_stage_path}"; then
    :
  else
    setup_status=$?
    cleanup_remote_dir_best_effort "${remote_stage_dir}"
    return "${setup_status}"
  fi

  local -a native_tokens=("${native_command}" "--kind" "$(encode_utf8_b64 "${kind}")" "--file" "$(encode_utf8_b64 "${remote_stage_path}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ "${kind}" == "powershell" && -n "${TARGET_PS_EXE}" ]]; then
    native_tokens+=("--exe" "$(encode_utf8_b64 "${TARGET_PS_EXE}")")
  fi

  local run_status=0
  if [[ ${native_bridge_supported} -eq 1 ]]; then
    local native_output_dir
    native_output_dir="$(mktemp -d)"
    local native_stdout="${native_output_dir}/stdout"
    local native_stderr="${native_output_dir}/stderr"
    if ssh_exec_native_tokens "${native_tokens[@]}" >"${native_stdout}" 2>"${native_stderr}"; then
      cat "${native_stdout}"
      cat "${native_stderr}" >&2
      run_status=0
    else
      local native_status=$?
      if grep -F -- "Unknown command: ${native_command}" "${native_stderr}" >/dev/null; then
        if invoke_exec_file_compat_bridge "${mode}" "${kind}" "${cwd}" "${remote_stage_path}" "${native_command}" "rejected"; then
          run_status=0
        else
          run_status=$?
        fi
      else
        run_status=${native_status}
        cat "${native_stdout}"
        cat "${native_stderr}" >&2
      fi
    fi
    rm -rf "${native_output_dir}"
  else
    if invoke_exec_file_compat_bridge "${mode}" "${kind}" "${cwd}" "${remote_stage_path}" "${native_command}"; then
      run_status=0
    else
      run_status=$?
    fi
  fi

  cleanup_remote_dir_best_effort "${remote_stage_dir}"
  return "${run_status}"
}

invoke_exec_file_compat_bridge() {
  local mode="$1"
  local kind="$2"
  local cwd="$3"
  local remote_stage_path="$4"
  local missing_native_command="$5"
  local support_message="${6:-does not advertise}"

  local native_route="run-b64"
  if [[ "${mode}" == "capture" ]]; then
    native_route="capture-b64"
  fi

  warn_compat_route "remote native ${support_message} ${missing_native_command}; using ${native_route} to run the staged ${kind} payload. Update the target executor when convenient."

  local -a native_tokens=("${native_route}")
  case "${kind}" in
    powershell)
      native_tokens+=("--file" "$(encode_utf8_b64 "${TARGET_PS_EXE:-powershell.exe}")")
      if [[ -n "${cwd}" ]]; then
        native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
      fi
      native_tokens+=(
        "--arg" "$(encode_utf8_b64 "-NoLogo")"
        "--arg" "$(encode_utf8_b64 "-NoProfile")"
        "--arg" "$(encode_utf8_b64 "-ExecutionPolicy")"
        "--arg" "$(encode_utf8_b64 "Bypass")"
        "--arg" "$(encode_utf8_b64 "-File")"
        "--arg" "$(encode_utf8_b64 "${remote_stage_path}")"
      )
      ;;
    cmd)
      local remote_stage_path_cmd
      remote_stage_path_cmd="$(remote_cmd_path "${remote_stage_path}")"
      native_tokens+=("--file" "$(encode_utf8_b64 "cmd.exe")")
      if [[ -n "${cwd}" ]]; then
        native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
      fi
      native_tokens+=(
        "--arg" "$(encode_utf8_b64 "/d")"
        "--arg" "$(encode_utf8_b64 "/c")"
        "--arg" "$(encode_utf8_b64 "call")"
        "--arg" "$(encode_utf8_b64 "${remote_stage_path_cmd}")"
      )
      ;;
    *)
      die "Unsupported exec compat shell: ${kind}"
      ;;
  esac

  ssh_exec_native_tokens "${native_tokens[@]}"
}

render_native_launcher() {
  local primary_path="$1"
  local fallback_path="$2"

  cat <<EOF
@echo off
setlocal EnableExtensions EnableDelayedExpansion
set "WINDOWS_REMOTE_EXECUTOR_PRIMARY=$(remote_cmd_path "${primary_path}")"
set "WINDOWS_REMOTE_EXECUTOR_FALLBACK=$(remote_cmd_path "${fallback_path}")"
if exist "%WINDOWS_REMOTE_EXECUTOR_PRIMARY%" (
  "%WINDOWS_REMOTE_EXECUTOR_PRIMARY%" %*
  exit /b !ERRORLEVEL!
)
if exist "%WINDOWS_REMOTE_EXECUTOR_FALLBACK%" (
  "%WINDOWS_REMOTE_EXECUTOR_FALLBACK%" %*
  exit /b !ERRORLEVEL!
)
echo error: WindowsRemoteExecutor native payload not found. 1>&2
exit /b 127
EOF
}

ssh_exec_native_tokens() {
  local -a native_tokens=("$@")
  if [[ -n "${TARGET_ACCESS_TOKEN}" ]]; then
    native_tokens+=("--access-token" "$(encode_utf8_b64 "${TARGET_ACCESS_TOKEN}")")
  fi

  local launcher_path="${TARGET_NATIVE_LAUNCHER}"
  local fallback_path="${TARGET_NATIVE_EXE}"
  local code=""
  local current_release_dir=""
  local selected_native_path=""

  if [[ -n "${TARGET_NATIVE_CURRENT_FILE:-}" ]]; then
    current_release_dir="$(remote_current_release_dir_best_effort || true)"
  fi

  if [[ -n "${current_release_dir}" ]]; then
    local current_native_path="${current_release_dir}/WindowsRemoteExecutor.Native.exe"
    if remote_file_exists_best_effort "${current_native_path}"; then
      selected_native_path="${current_native_path}"
    fi
  fi

  if [[ -z "${selected_native_path}" ]] && remote_file_exists_best_effort "${fallback_path}"; then
    selected_native_path="${fallback_path}"
  fi

  if [[ -n "${selected_native_path}" ]]; then
    code="$(build_native_invoke_body "${selected_native_path}" "${native_tokens[@]}")"
  elif [[ "${launcher_path}" == "${fallback_path}" ]]; then
    code="$(build_native_invoke_code "${fallback_path}" "${native_tokens[@]}")"
  else
    local launcher_body
    launcher_body="$(build_native_invoke_body "${launcher_path}" "${native_tokens[@]}")"
    local fallback_cmd
    fallback_cmd="$(build_native_invoke_code "${fallback_path}" "${native_tokens[@]}")"
    local launcher_path_cmd
    launcher_path_cmd="$(remote_cmd_path "${launcher_path}")"
    code="if exist \"${launcher_path_cmd}\" (${launcher_body}) else (${fallback_cmd})"
  fi

  ssh_raw "${TARGET_USER}@${TARGET_HOST}" "cmd.exe /v:on /d /s /c \"${code} & exit /b !ERRORLEVEL!\""
}

scp_to_remote() {
  local local_path="$1"
  local remote_path="$2"
  remote_path="$(normalize_remote_path "${remote_path}")"
  if remote_path_requires_staged_transfer "${remote_path}"; then
    [[ -f "${local_path}" ]] || die "Staged upload only supports files: ${local_path}"
    staged_file_upload "${local_path}" "${remote_path}"
    return
  fi

  scp_raw "${local_path}" "$(scp_remote_spec "${remote_path}")"
}

scp_from_remote() {
  local remote_path="$1"
  local local_path="$2"
  remote_path="$(normalize_remote_path "${remote_path}")"
  if remote_path_requires_staged_transfer "${remote_path}"; then
    staged_file_download "${remote_path}" "${local_path}"
    return
  fi

  scp_raw "$(scp_remote_spec "${remote_path}")" "${local_path}"
}

remote_path_requires_staged_transfer() {
  local remote_path="$1"
  [[ "${remote_path}" =~ [[:space:]\'\"\`\&\(\)\;\|\<\>\^\!] ]]
}

copy_remote_file_bridge() {
  local source_path="$1"
  local destination_path="$2"

  if remote_native_supports_command "copy-file-b64"; then
    copy_remote_file_native_or_compat "${source_path}" "${destination_path}"
    return
  fi

  case "$?" in
    1)
      copy_remote_file_compat "${source_path}" "${destination_path}"
      ;;
    *)
      copy_remote_file_native_or_compat "${source_path}" "${destination_path}"
      ;;
  esac
}

copy_remote_file_native_or_compat() {
  local source_path="$1"
  local destination_path="$2"
  local copy_output=""
  local copy_status=0

  if copy_output="$(ssh_exec_native_tokens \
    "copy-file-b64" \
    "--source" "$(encode_utf8_b64 "${source_path}")" \
    "--destination" "$(encode_utf8_b64 "${destination_path}")" 2>&1)"; then
    printf '%s' "${copy_output}"
    return 0
  fi

  copy_status=$?
  if [[ "${copy_output}" == *"Unknown command: copy-file-b64"* ]]; then
    copy_remote_file_compat "${source_path}" "${destination_path}"
    return
  fi

  printf '%s\n' "${copy_output}" >&2
  return "${copy_status}"
}

copy_remote_file_compat() {
  local source_path="$1"
  local destination_path="$2"
  warn_compat_route "remote native does not advertise copy-file-b64; using run-b64 PowerShell Copy-Item compatibility path."

  local source_b64
  local destination_b64
  source_b64="$(encode_utf8_b64 "${source_path}")"
  destination_b64="$(encode_utf8_b64 "${destination_path}")"

  local ps_script
  ps_script="$(cat <<EOF
\$ErrorActionPreference = 'Stop'
\$source = [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('${source_b64}'))
\$destination = [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('${destination_b64}'))
\$parent = [System.IO.Path]::GetDirectoryName(\$destination)
if (-not [string]::IsNullOrWhiteSpace(\$parent)) {
  New-Item -ItemType Directory -Path \$parent -Force | Out-Null
}
Copy-Item -LiteralPath \$source -Destination \$destination -Force -ErrorAction Stop
if (-not [System.IO.File]::Exists(\$destination)) {
  throw "Copy-Item completed but destination file is missing: \$destination"
}
EOF
)"

  local encoded_command
  encoded_command="$(encode_powershell "$(compose_powershell_script "${ps_script}")")"

  ssh_exec_native_tokens \
    "run-b64" \
    "--file" "$(encode_utf8_b64 "${TARGET_PS_EXE:-powershell.exe}")" \
    "--arg" "$(encode_utf8_b64 "-NoLogo")" \
    "--arg" "$(encode_utf8_b64 "-NoProfile")" \
    "--arg" "$(encode_utf8_b64 "-ExecutionPolicy")" \
    "--arg" "$(encode_utf8_b64 "Bypass")" \
    "--arg" "$(encode_utf8_b64 "-EncodedCommand")" \
    "--arg" "$(encode_utf8_b64 "${encoded_command}")"
}

staged_file_upload() {
  local local_path="$1"
  local remote_path="$2"
  local stage_id
  stage_id="$(generate_stage_id)"
  local remote_stage_dir="${TARGET_STAGE_ROOT}/file-transfer-${stage_id}"
  local remote_stage_path="${remote_stage_dir}/payload"

  ensure_remote_dir "${remote_stage_dir}"
  scp_raw "${local_path}" "$(scp_remote_spec "${remote_stage_path}")"

  local status=0
  if copy_remote_file_bridge "${remote_stage_path}" "${remote_path}" >/dev/null; then
    status=0
  else
    status=$?
  fi

  cleanup_remote_dir_best_effort "${remote_stage_dir}"
  return "${status}"
}

staged_file_download() {
  local remote_path="$1"
  local local_path="$2"
  local stage_id
  stage_id="$(generate_stage_id)"
  local remote_stage_dir="${TARGET_STAGE_ROOT}/file-transfer-${stage_id}"
  local remote_stage_path="${remote_stage_dir}/payload"

  ensure_remote_dir "${remote_stage_dir}"

  local status=0
  if copy_remote_file_bridge "${remote_path}" "${remote_stage_path}" >/dev/null; then
    :
  else
    status=$?
    cleanup_remote_dir_best_effort "${remote_stage_dir}"
    return "${status}"
  fi

  if scp_raw "$(scp_remote_spec "${remote_stage_path}")" "${local_path}"; then
    status=0
  else
    status=$?
  fi

  cleanup_remote_dir_best_effort "${remote_stage_dir}"
  return "${status}"
}

cmd_exec() {
  [[ $# -ge 2 ]] || die "exec requires <target> plus inline script, --file <local-script>, or --stdin"
  local target="$1"
  shift

  local cwd=""
  local kind="powershell"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a remote directory"
        cwd="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --shell|--kind)
        [[ $# -ge 2 ]] || die "$1 requires powershell or cmd"
        kind="$(normalize_exec_kind "$2")"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  load_target "${target}"
  prepare_exec_source_file "exec" "${kind}" "$@"

  local status=0
  if invoke_exec_file_bridge "run" "${kind}" "${cwd}" "${PREPARED_EXEC_SOURCE_FILE}"; then
    status=0
  else
    status=$?
  fi

  cleanup_exec_source_best_effort "${PREPARED_EXEC_CLEANUP_DIR}"
  return "${status}"
}

cmd_exec_capture() {
  [[ $# -ge 2 ]] || die "exec-capture requires <target> plus inline script, --file <local-script>, or --stdin"
  local target="$1"
  shift

  local cwd=""
  local kind="powershell"
  local out_file=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a remote directory"
        cwd="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --shell|--kind)
        [[ $# -ge 2 ]] || die "$1 requires powershell or cmd"
        kind="$(normalize_exec_kind "$2")"
        shift 2
        ;;
      --out)
        [[ $# -ge 2 ]] || die "--out requires a local JSON file path"
        out_file="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  load_target "${target}"
  prepare_exec_source_file "exec-capture" "${kind}" "$@"

  local capture_output=""
  local capture_status=0
  if capture_output="$(invoke_exec_file_bridge "capture" "${kind}" "${cwd}" "${PREPARED_EXEC_SOURCE_FILE}")"; then
    capture_status=0
  else
    capture_status=$?
  fi

  cleanup_exec_source_best_effort "${PREPARED_EXEC_CLEANUP_DIR}"
  print_capture_output "${capture_output}" "${out_file}"
  return "${capture_status}"
}

cmd_cmd() {
  [[ $# -ge 2 ]] || die "cmd requires <target> <cmd-code>"
  load_target "$1"
  shift
  local temp_dir
  temp_dir="$(mktemp -d)"
  local local_script_path="${temp_dir}/payload.cmd"
  printf '%s' "$*" >"${local_script_path}"

  local status=0
  if invoke_exec_file_bridge "run" "cmd" "" "${local_script_path}"; then
    status=0
  else
    status=$?
  fi

  cleanup_exec_source_best_effort "${temp_dir}"
  return "${status}"
}

cmd_run() {
  [[ $# -ge 2 ]] || die "run requires <target> [--cwd <remote-dir>] [--allow-powershell] <program> [args...]"
  local target="$1"
  shift

  local cwd=""
  local allow_powershell=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a directory"
        cwd="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --allow-powershell)
        allow_powershell=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -ge 1 ]] || die "run requires a program"

  load_target "${target}"

  local program="$1"
  shift
  guard_raw_powershell_program "run" "${allow_powershell}" "${program}"

  local -a native_tokens=("run-b64" "--file" "$(encode_utf8_b64 "${program}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi

  local arg
  for arg in "$@"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  ssh_exec_native_tokens "${native_tokens[@]}"
}

cmd_capture() {
  [[ $# -ge 2 ]] || die "capture requires <target> [--cwd <remote-dir>] [--out <local-json-file>] [--allow-powershell] [--cmd <cmd-code> | <program> [args...]]"
  local target="$1"
  shift

  local cwd=""
  local out_file=""
  local allow_powershell=0
  local cmd_code=""
  local use_cmd_code=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a directory"
        cwd="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --out)
        [[ $# -ge 2 ]] || die "--out requires a local file path"
        out_file="$2"
        shift 2
        ;;
      --allow-powershell)
        allow_powershell=1
        shift
        ;;
      --cmd)
        [[ $# -ge 2 ]] || die "--cmd requires cmd.exe code"
        cmd_code="$2"
        use_cmd_code=1
        shift 2
        break
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ ${use_cmd_code} -eq 1 && $# -gt 0 ]]; then
    die "capture --cmd does not accept extra program arguments"
  fi
  [[ ${use_cmd_code} -eq 1 || $# -ge 1 ]] || die "capture requires --cmd <cmd-code> or a program"

  load_target "${target}"

  local program
  local -a command_args=()
  if [[ ${use_cmd_code} -eq 1 ]]; then
    program="cmd.exe"
    command_args=("/d" "/s" "/c" "${cmd_code}")
  else
    program="$1"
    shift
    command_args=("$@")
    guard_raw_powershell_program "capture" "${allow_powershell}" "${program}"
  fi

  local -a native_tokens=("capture-b64" "--file" "$(encode_utf8_b64 "${program}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi

  local arg
  for arg in "${command_args[@]}"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  local capture_output=""
  local capture_status=0
  if capture_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    capture_status=0
  else
    capture_status=$?
  fi

  if [[ -n "${out_file}" ]]; then
    mkdir -p "$(dirname "${out_file}")"
    printf '%s\n' "${capture_output}" | tee "${out_file}"
  else
    printf '%s\n' "${capture_output}"
  fi

  return "${capture_status}"
}

cmd_spawn() {
  [[ $# -ge 2 ]] || die "spawn requires <target> [--cwd <remote-dir>] [--stdout <remote-log>] [--stderr <remote-log>] [--out <local-json-file>] [--allow-powershell] <program> [args...]"
  local target="$1"
  shift

  local cwd=""
  local stdout_path=""
  local stderr_path=""
  local out_file=""
  local allow_powershell=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a directory"
        cwd="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --stdout)
        [[ $# -ge 2 ]] || die "--stdout requires a remote log path"
        stdout_path="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --stderr)
        [[ $# -ge 2 ]] || die "--stderr requires a remote log path"
        stderr_path="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --out)
        [[ $# -ge 2 ]] || die "--out requires a local file path"
        out_file="$2"
        shift 2
        ;;
      --allow-powershell)
        allow_powershell=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -ge 1 ]] || die "spawn requires a program"

  load_target "${target}"

  local program="$1"
  shift
  guard_raw_powershell_program "spawn" "${allow_powershell}" "${program}"
  if remote_native_supports_command "spawn-b64"; then
    :
  else
    case "$?" in
      1)
        die "Remote native executor does not support spawn-b64. Update the target with 'win-remote update-tools <target> --native-zip <release-asset.zip>', or use capture --allow-powershell with a staged Start-Process launcher for this host."
        ;;
      *)
        ;;
    esac
  fi

  local -a native_tokens=("spawn-b64" "--file" "$(encode_utf8_b64 "${program}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${stdout_path}" ]]; then
    native_tokens+=("--stdout" "$(encode_utf8_b64 "${stdout_path}")")
  fi
  if [[ -n "${stderr_path}" ]]; then
    native_tokens+=("--stderr" "$(encode_utf8_b64 "${stderr_path}")")
  fi

  local arg
  for arg in "$@"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  local spawn_output=""
  local spawn_status=0
  if spawn_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    spawn_status=0
  else
    spawn_status=$?
  fi

  if [[ -n "${out_file}" ]]; then
    mkdir -p "$(dirname "${out_file}")"
    printf '%s\n' "${spawn_output}" | tee "${out_file}"
  else
    printf '%s\n' "${spawn_output}"
  fi

  return "${spawn_status}"
}

print_capture_output() {
  local capture_output="$1"
  local out_file="${2:-}"

  if [[ -n "${out_file}" ]]; then
    mkdir -p "$(dirname "${out_file}")"
    printf '%s\n' "${capture_output}" | tee "${out_file}"
    return
  fi

  printf '%s\n' "${capture_output}"
}

cmd_wsl() {
  [[ $# -ge 2 ]] || die "wsl requires <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] <program> [args...]"
  local target="$1"
  shift

  local distro=""
  local linux_user=""
  local cwd=""
  local heartbeat_seconds=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --distro)
        [[ $# -ge 2 ]] || die "--distro requires a distribution name"
        distro="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a Linux user name"
        linux_user="$2"
        shift 2
        ;;
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a Linux directory"
        cwd="$2"
        shift 2
        ;;
      --heartbeat-seconds)
        [[ $# -ge 2 ]] || die "--heartbeat-seconds requires a positive integer"
        validate_positive_integer "$2" "--heartbeat-seconds"
        heartbeat_seconds="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -ge 1 ]] || die "wsl requires a Linux program path"

  load_target "${target}"
  [[ -n "${distro}" ]] || distro="${TARGET_WSL_DISTRO}"
  [[ -n "${linux_user}" ]] || linux_user="${TARGET_WSL_USER}"

  local program="$1"
  shift

  if [[ "${heartbeat_seconds}" != "0" ]]; then
    local heartbeat_script
    heartbeat_script="$(render_wsl_heartbeat_wrapper)"
    local -a native_tokens=("wsl-script-b64" "--script" "$(encode_utf8_b64 "${heartbeat_script}")" "--shell" "$(encode_utf8_b64 "/bin/bash")")
    if [[ -n "${cwd}" ]]; then
      native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
    fi
    if [[ -n "${distro}" ]]; then
      native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
    fi
    if [[ -n "${linux_user}" ]]; then
      native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
    fi
    native_tokens+=("--arg" "$(encode_utf8_b64 "${heartbeat_seconds}")")
    native_tokens+=("--arg" "$(encode_utf8_b64 "${program}")")
    local arg
    for arg in "$@"; do
      native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
    done
    ssh_exec_native_tokens "${native_tokens[@]}"
    return
  fi

  local -a native_tokens=("wsl-b64" "--file" "$(encode_utf8_b64 "${program}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${distro}" ]]; then
    native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
  fi
  if [[ -n "${linux_user}" ]]; then
    native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
  fi

  local arg
  for arg in "$@"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  ssh_exec_native_tokens "${native_tokens[@]}"
}

cmd_wsl_capture() {
  [[ $# -ge 2 ]] || die "wsl-capture requires <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--out <local-json-file>] [--heartbeat-seconds <n>] <program> [args...]"
  local target="$1"
  shift

  local distro=""
  local linux_user=""
  local cwd=""
  local out_file=""
  local heartbeat_seconds=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --distro)
        [[ $# -ge 2 ]] || die "--distro requires a distribution name"
        distro="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a Linux user name"
        linux_user="$2"
        shift 2
        ;;
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a Linux directory"
        cwd="$2"
        shift 2
        ;;
      --out)
        [[ $# -ge 2 ]] || die "--out requires a local file path"
        out_file="$2"
        shift 2
        ;;
      --heartbeat-seconds)
        [[ $# -ge 2 ]] || die "--heartbeat-seconds requires a positive integer"
        validate_positive_integer "$2" "--heartbeat-seconds"
        heartbeat_seconds="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -ge 1 ]] || die "wsl-capture requires a Linux program path"

  load_target "${target}"
  [[ -n "${distro}" ]] || distro="${TARGET_WSL_DISTRO}"
  [[ -n "${linux_user}" ]] || linux_user="${TARGET_WSL_USER}"

  local program="$1"
  shift

  if [[ "${heartbeat_seconds}" != "0" ]]; then
    local heartbeat_script
    heartbeat_script="$(render_wsl_heartbeat_wrapper)"
    local -a native_tokens=("wsl-script-capture-b64" "--script" "$(encode_utf8_b64 "${heartbeat_script}")" "--shell" "$(encode_utf8_b64 "/bin/bash")")
    if [[ -n "${cwd}" ]]; then
      native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
    fi
    if [[ -n "${distro}" ]]; then
      native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
    fi
    if [[ -n "${linux_user}" ]]; then
      native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
    fi
    native_tokens+=("--arg" "$(encode_utf8_b64 "${heartbeat_seconds}")")
    native_tokens+=("--arg" "$(encode_utf8_b64 "${program}")")

    local arg
    for arg in "$@"; do
      native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
    done

    local capture_output=""
    local capture_status=0
    if capture_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
      capture_status=0
    else
      capture_status=$?
    fi

    print_capture_output "${capture_output}" "${out_file}"
    return "${capture_status}"
  fi

  local -a native_tokens=("wsl-capture-b64" "--file" "$(encode_utf8_b64 "${program}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${distro}" ]]; then
    native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
  fi
  if [[ -n "${linux_user}" ]]; then
    native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
  fi

  local arg
  for arg in "$@"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  local capture_output=""
  local capture_status=0
  if capture_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    capture_status=0
  else
    capture_status=$?
  fi

  print_capture_output "${capture_output}" "${out_file}"
  return "${capture_status}"
}

cmd_wsl_py_common() {
  local mode="$1"
  shift
  [[ $# -ge 2 ]] || die "${mode} requires <target> [options] [--module <module> | <script-path>] [-- <script-args...>]"
  local target="$1"
  shift

  local distro=""
  local linux_user=""
  local cwd=""
  local python_path="python3"
  local module_name=""
  local out_file=""
  local heartbeat_seconds=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --distro)
        [[ $# -ge 2 ]] || die "--distro requires a distribution name"
        distro="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a Linux user name"
        linux_user="$2"
        shift 2
        ;;
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a Linux directory"
        cwd="$2"
        shift 2
        ;;
      --python)
        [[ $# -ge 2 ]] || die "--python requires a Linux Python executable path"
        python_path="$2"
        shift 2
        ;;
      --module)
        [[ $# -ge 2 ]] || die "--module requires a Python module name"
        module_name="$2"
        shift 2
        ;;
      --out)
        [[ "${mode}" == "wsl-py-capture" ]] || die "--out is only valid for wsl-py-capture"
        [[ $# -ge 2 ]] || die "--out requires a local JSON file path"
        out_file="$2"
        shift 2
        ;;
      --heartbeat-seconds)
        [[ $# -ge 2 ]] || die "--heartbeat-seconds requires a positive integer"
        validate_positive_integer "$2" "--heartbeat-seconds"
        heartbeat_seconds="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  local -a python_args=()
  if [[ -n "${module_name}" ]]; then
    python_args+=("-m" "${module_name}")
  else
    [[ $# -ge 1 ]] || die "${mode} requires a script path unless --module is provided"
    python_args+=("$1")
    shift
  fi
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  python_args+=("$@")

  load_target "${target}"
  [[ -n "${distro}" ]] || distro="${TARGET_WSL_DISTRO}"
  [[ -n "${linux_user}" ]] || linux_user="${TARGET_WSL_USER}"

  local native_command="wsl-b64"
  if [[ "${mode}" == "wsl-py-capture" ]]; then
    native_command="wsl-capture-b64"
  fi

  local -a native_tokens=()
  if [[ "${heartbeat_seconds}" != "0" ]]; then
    local heartbeat_script
    heartbeat_script="$(render_wsl_heartbeat_wrapper)"
    native_command="wsl-script-b64"
    if [[ "${mode}" == "wsl-py-capture" ]]; then
      native_command="wsl-script-capture-b64"
    fi
    native_tokens=("${native_command}" "--script" "$(encode_utf8_b64 "${heartbeat_script}")" "--shell" "$(encode_utf8_b64 "/bin/bash")")
  else
    native_tokens=("${native_command}" "--file" "$(encode_utf8_b64 "${python_path}")")
  fi

  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${distro}" ]]; then
    native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
  fi
  if [[ -n "${linux_user}" ]]; then
    native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
  fi

  if [[ "${heartbeat_seconds}" != "0" ]]; then
    native_tokens+=("--arg" "$(encode_utf8_b64 "${heartbeat_seconds}")")
    native_tokens+=("--arg" "$(encode_utf8_b64 "${python_path}")")
  fi

  local arg
  for arg in "${python_args[@]}"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  local output=""
  local status=0
  if output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    status=0
  else
    status=$?
  fi

  if [[ "${mode}" == "wsl-py-capture" ]]; then
    print_capture_output "${output}" "${out_file}"
  else
    printf '%s\n' "${output}"
  fi
  return "${status}"
}

cmd_wsl_py() {
  cmd_wsl_py_common "wsl-py" "$@"
}

cmd_wsl_py_capture() {
  cmd_wsl_py_common "wsl-py-capture" "$@"
}

cmd_wsl_sh() {
  [[ $# -ge 2 ]] || die "wsl-sh requires <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--shell <linux-shell>] [--heartbeat-seconds <n>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]"
  local target="$1"
  shift

  local distro=""
  local linux_user=""
  local cwd=""
  local shell_path=""
  local heartbeat_seconds=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --distro)
        [[ $# -ge 2 ]] || die "--distro requires a distribution name"
        distro="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a Linux user name"
        linux_user="$2"
        shift 2
        ;;
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a Linux directory"
        cwd="$2"
        shift 2
        ;;
      --shell)
        [[ $# -ge 2 ]] || die "--shell requires a Linux shell path"
        shell_path="$2"
        shift 2
        ;;
      --heartbeat-seconds)
        [[ $# -ge 2 ]] || die "--heartbeat-seconds requires a positive integer"
        validate_positive_integer "$2" "--heartbeat-seconds"
        heartbeat_seconds="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  load_target "${target}"
  [[ -n "${distro}" ]] || distro="${TARGET_WSL_DISTRO}"
  [[ -n "${linux_user}" ]] || linux_user="${TARGET_WSL_USER}"
  [[ -n "${shell_path}" ]] || shell_path="${TARGET_WSL_SHELL}"

  local source_mode="${1:-}"
  local local_script_path=""
  local cleanup_local_script=0
  local -a script_args=()
  case "${source_mode}" in
    --file)
      [[ $# -ge 2 ]] || die "wsl-sh --file requires a local file path"
      [[ -f "$2" ]] || die "Local file not found: $2"
      local_script_path="$2"
      shift 2
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      ;;
    --stdin)
      local_script_path="$(mktemp)"
      cleanup_local_script=1
      shift
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      cat >"${local_script_path}"
      ;;
    *)
      local -a inline_parts=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --)
            shift
            break
            ;;
          *)
            inline_parts+=("$1")
            shift
            ;;
        esac
      done
      [[ ${#inline_parts[@]} -gt 0 ]] || die "wsl-sh requires inline shell, --file <local-sh>, or --stdin"
      local_script_path="$(mktemp)"
      cleanup_local_script=1
      printf '%s' "${inline_parts[*]}" >"${local_script_path}"
      ;;
  esac
  script_args=("$@")

  local stage_id
  stage_id="$(generate_stage_id)"
  local remote_stage_dir="${TARGET_STAGE_ROOT}/wsl-script-${stage_id}"
  local remote_stage_path="${remote_stage_dir}/payload.sh"
  local stage_wsl_path
  stage_wsl_path="$(remote_windows_path_to_wsl "${remote_stage_path}")"
  local linux_temp_path="/tmp/windows-remote-executor-${stage_id}.sh"
  local bootstrap_script
  bootstrap_script="$(render_wsl_stage_bootstrap "${heartbeat_seconds}")"

  local setup_status=0
  if ensure_remote_dir "${remote_stage_dir}"; then
    :
  else
    setup_status=$?
    cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"
    return "${setup_status}"
  fi
  if scp_to_remote "${local_script_path}" "${remote_stage_path}"; then
    :
  else
    setup_status=$?
    cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"
    return "${setup_status}"
  fi

  local -a native_tokens=("wsl-script-b64" "--script" "$(encode_utf8_b64 "${bootstrap_script}")" "--shell" "$(encode_utf8_b64 "/bin/sh")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${distro}" ]]; then
    native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
  fi
  if [[ -n "${linux_user}" ]]; then
    native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
  fi
  native_tokens+=("--arg" "$(encode_utf8_b64 "${stage_wsl_path}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${linux_temp_path}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${shell_path}")")
  if [[ "${heartbeat_seconds}" != "0" ]]; then
    native_tokens+=("--arg" "$(encode_utf8_b64 "${heartbeat_seconds}")")
  fi

  if [[ ${#script_args[@]} -gt 0 ]]; then
    local arg
    for arg in "${script_args[@]}"; do
      native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
    done
  fi

  local run_status=0
  if ssh_exec_native_tokens "${native_tokens[@]}"; then
    run_status=0
  else
    run_status=$?
  fi

  cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"

  return "${run_status}"
}

cmd_wsl_sh_capture() {
  [[ $# -ge 2 ]] || die "wsl-sh-capture requires <target> [--distro <name>] [--user <linux-user>] [--cwd <linux-dir>] [--shell <linux-shell>] [--out <local-json-file>] [--heartbeat-seconds <n>] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]"
