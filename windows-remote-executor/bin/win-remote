cmd_wsl_container_sh_common() {
  local mode="$1"
  shift
  [[ $# -ge 2 ]] || die "${mode} requires <target> [options] --container <name> [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]"
  local target="$1"
  shift

  local distro=""
  local linux_user=""
  local cwd=""
  local out_file=""
  local heartbeat_seconds=0
  local container=""
  local container_runtime="docker"
  local container_cwd=""
  local container_user=""
  local container_shell="/bin/sh"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --distro)
        [[ $# -ge 2 ]] || die "--distro requires a distribution name"
        distro="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a Linux user name"
        linux_user="$2"
        shift 2
        ;;
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a Linux directory"
        cwd="$2"
        shift 2
        ;;
      --out)
        [[ "${mode}" == "wsl-container-sh-capture" ]] || die "--out is only valid for wsl-container-sh-capture"
        [[ $# -ge 2 ]] || die "--out requires a local JSON file path"
        out_file="$2"
        shift 2
        ;;
      --heartbeat-seconds)
        [[ $# -ge 2 ]] || die "--heartbeat-seconds requires a positive integer"
        validate_positive_integer "$2" "--heartbeat-seconds"
        heartbeat_seconds="$2"
        shift 2
        ;;
      --container)
        [[ $# -ge 2 ]] || die "--container requires a container name or id"
        container="$2"
        shift 2
        ;;
      --container-runtime)
        [[ $# -ge 2 ]] || die "--container-runtime requires docker, podman, or an executable path"
        container_runtime="$2"
        shift 2
        ;;
      --container-cwd)
        [[ $# -ge 2 ]] || die "--container-cwd requires a container working directory"
        container_cwd="$2"
        shift 2
        ;;
      --container-user)
        [[ $# -ge 2 ]] || die "--container-user requires a container user"
        container_user="$2"
        shift 2
        ;;
      --container-shell)
        [[ $# -ge 2 ]] || die "--container-shell requires a shell path inside the container"
        container_shell="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  [[ -n "${container}" ]] || die "${mode} requires --container <name>"

  load_target "${target}"
  [[ -n "${distro}" ]] || distro="${TARGET_WSL_DISTRO}"
  [[ -n "${linux_user}" ]] || linux_user="${TARGET_WSL_USER}"

  local source_mode="${1:-}"
  local local_script_path=""
  local cleanup_local_script=0
  local -a script_args=()
  case "${source_mode}" in
    --file)
      [[ $# -ge 2 ]] || die "${mode} --file requires a local file path"
      [[ -f "$2" ]] || die "Local file not found: $2"
      local_script_path="$2"
      shift 2
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      ;;
    --stdin)
      local_script_path="$(mktemp)"
      cleanup_local_script=1
      shift
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      cat >"${local_script_path}"
      ;;
    *)
      local -a inline_parts=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --)
            shift
            break
            ;;
          *)
            inline_parts+=("$1")
            shift
            ;;
        esac
      done
      [[ ${#inline_parts[@]} -gt 0 ]] || die "${mode} requires inline shell, --file <local-sh>, or --stdin"
      local_script_path="$(mktemp)"
      cleanup_local_script=1
      printf '%s' "${inline_parts[*]}" >"${local_script_path}"
      ;;
  esac
  script_args=("$@")

  local stage_id
  stage_id="$(generate_stage_id)"
  local remote_stage_dir="${TARGET_STAGE_ROOT}/wsl-container-${stage_id}"
  local remote_stage_path="${remote_stage_dir}/payload.sh"
  local stage_wsl_path
  stage_wsl_path="$(remote_windows_path_to_wsl "${remote_stage_path}")"
  local linux_temp_path="/tmp/windows-remote-executor-container-${stage_id}.sh"
  local bootstrap_script
  bootstrap_script="$(render_wsl_container_stage_bootstrap "${heartbeat_seconds}")"

  local setup_status=0
  if ensure_remote_dir "${remote_stage_dir}"; then
    :
  else
    setup_status=$?
    cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"
    return "${setup_status}"
  fi
  if scp_to_remote "${local_script_path}" "${remote_stage_path}"; then
    :
  else
    setup_status=$?
    cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"
    return "${setup_status}"
  fi

  local native_command="wsl-script-b64"
  if [[ "${mode}" == "wsl-container-sh-capture" ]]; then
    native_command="wsl-script-capture-b64"
  fi

  local -a native_tokens=("${native_command}" "--script" "$(encode_utf8_b64 "${bootstrap_script}")" "--shell" "$(encode_utf8_b64 "/bin/bash")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${distro}" ]]; then
    native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
  fi
  if [[ -n "${linux_user}" ]]; then
    native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
  fi
  native_tokens+=("--arg" "$(encode_utf8_b64 "${stage_wsl_path}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${linux_temp_path}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${container_runtime}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${container}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${container_shell}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${container_cwd}")")
  native_tokens+=("--arg" "$(encode_utf8_b64 "${container_user}")")
  if [[ "${heartbeat_seconds}" != "0" ]]; then
    native_tokens+=("--arg" "$(encode_utf8_b64 "${heartbeat_seconds}")")
  fi

  if [[ ${#script_args[@]} -gt 0 ]]; then
    local arg
    for arg in "${script_args[@]}"; do
      native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
    done
  fi

  local output=""
  local status=0
  if output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    status=0
  else
    status=$?
  fi

  cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"

  if [[ "${mode}" == "wsl-container-sh-capture" ]]; then
    print_capture_output "${output}" "${out_file}"
  else
    printf '%s\n' "${output}"
  fi
  return "${status}"
}

cmd_wsl_container_sh() {
  cmd_wsl_container_sh_common "wsl-container-sh" "$@"
}

cmd_wsl_container_sh_capture() {
  cmd_wsl_container_sh_common "wsl-container-sh-capture" "$@"
}

cmd_wsl_resident() {
  [[ $# -ge 2 ]] || die "wsl-resident requires <target> [options] [--file <local-sh> | --stdin | <shell-code>] [-- <script-args...>]"
  local target="$1"
  shift

  local distro=""
  local linux_user=""
  local cwd=""
  local shell_path=""
  local pid_file=""
  local log_file=""
  local health_url=""
  local port=""
  local ready_timeout="20"
  local settle_delay="2"
  local poll_interval_ms="500"
  local diag_lines="20"
  local out_file=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --distro)
        [[ $# -ge 2 ]] || die "--distro requires a distribution name"
        distro="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a Linux user name"
        linux_user="$2"
        shift 2
        ;;
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a Linux directory"
        cwd="$2"
        shift 2
        ;;
      --shell)
        [[ $# -ge 2 ]] || die "--shell requires a Linux shell path"
        shell_path="$2"
        shift 2
        ;;
      --pid-file)
        [[ $# -ge 2 ]] || die "--pid-file requires a Linux path"
        pid_file="$2"
        shift 2
        ;;
      --log-file)
        [[ $# -ge 2 ]] || die "--log-file requires a Linux path"
        log_file="$2"
        shift 2
        ;;
      --port)
        [[ $# -ge 2 ]] || die "--port requires a positive integer"
        validate_positive_integer "$2" "--port"
        port="$2"
        shift 2
        ;;
      --health-url)
        [[ $# -ge 2 ]] || die "--health-url requires a URL"
        health_url="$2"
        shift 2
        ;;
      --ready-timeout)
        [[ $# -ge 2 ]] || die "--ready-timeout requires a positive integer"
        validate_positive_integer "$2" "--ready-timeout"
        ready_timeout="$2"
        shift 2
        ;;
      --settle-delay)
        [[ $# -ge 2 ]] || die "--settle-delay requires a non-negative integer"
        [[ "$2" =~ ^[0-9]+$ ]] || die "--settle-delay must be a non-negative integer"
        settle_delay="$2"
        shift 2
        ;;
      --poll-interval-ms)
        [[ $# -ge 2 ]] || die "--poll-interval-ms requires a positive integer"
        validate_positive_integer "$2" "--poll-interval-ms"
        poll_interval_ms="$2"
        shift 2
        ;;
      --diag-lines)
        [[ $# -ge 2 ]] || die "--diag-lines requires a positive integer"
        validate_positive_integer "$2" "--diag-lines"
        diag_lines="$2"
        shift 2
        ;;
      --out)
        [[ $# -ge 2 ]] || die "--out requires a local file path"
        out_file="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  load_target "${target}"
  [[ -n "${distro}" ]] || distro="${TARGET_WSL_DISTRO}"
  [[ -n "${linux_user}" ]] || linux_user="${TARGET_WSL_USER}"
  [[ -n "${shell_path}" ]] || shell_path="${TARGET_WSL_SHELL}"

  local source_mode="${1:-}"
  local local_script_path=""
  local cleanup_local_script=0
  local -a script_args=()
  case "${source_mode}" in
    --file)
      [[ $# -ge 2 ]] || die "wsl-resident --file requires a local file path"
      [[ -f "$2" ]] || die "Local file not found: $2"
      local_script_path="$2"
      shift 2
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      ;;
    --stdin)
      local_script_path="$(mktemp)"
      cleanup_local_script=1
      shift
      if [[ "${1:-}" == "--" ]]; then
        shift
      fi
      cat >"${local_script_path}"
      ;;
    *)
      local -a inline_parts=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --)
            shift
            break
            ;;
          *)
            inline_parts+=("$1")
            shift
            ;;
        esac
      done
      [[ ${#inline_parts[@]} -gt 0 ]] || die "wsl-resident requires inline shell, --file <local-sh>, or --stdin"
      local_script_path="$(mktemp)"
      cleanup_local_script=1
      printf '%s' "${inline_parts[*]}" >"${local_script_path}"
      ;;
  esac
  script_args=("$@")

  local stage_id
  stage_id="$(generate_stage_id)"
  local remote_stage_dir="${TARGET_STAGE_ROOT}/wsl-script-${stage_id}"
  local remote_stage_path="${remote_stage_dir}/payload.sh"
  local stage_wsl_path
  stage_wsl_path="$(remote_windows_path_to_wsl "${remote_stage_path}")"
  local launch_path="/tmp/windows-remote-executor-${stage_id}.sh"

  local setup_status=0
  if ensure_remote_dir "${remote_stage_dir}"; then
    :
  else
    setup_status=$?
    cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"
    return "${setup_status}"
  fi
  if scp_to_remote "${local_script_path}" "${remote_stage_path}"; then
    :
  else
    setup_status=$?
    cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"
    return "${setup_status}"
  fi

  local -a native_tokens=("wsl-resident-b64" "--stage-path" "$(encode_utf8_b64 "${stage_wsl_path}")" "--launch-path" "$(encode_utf8_b64 "${launch_path}")" "--shell" "$(encode_utf8_b64 "${shell_path}")" "--ready-timeout-seconds" "$(encode_utf8_b64 "${ready_timeout}")" "--settle-delay-seconds" "$(encode_utf8_b64 "${settle_delay}")" "--poll-interval-ms" "$(encode_utf8_b64 "${poll_interval_ms}")" "--diagnostic-lines" "$(encode_utf8_b64 "${diag_lines}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${distro}" ]]; then
    native_tokens+=("--distribution" "$(encode_utf8_b64 "${distro}")")
  fi
  if [[ -n "${linux_user}" ]]; then
    native_tokens+=("--user" "$(encode_utf8_b64 "${linux_user}")")
  fi
  if [[ -n "${pid_file}" ]]; then
    native_tokens+=("--pid-file" "$(encode_utf8_b64 "${pid_file}")")
  fi
  if [[ -n "${log_file}" ]]; then
    native_tokens+=("--log-file" "$(encode_utf8_b64 "${log_file}")")
  fi
  if [[ -n "${port}" ]]; then
    native_tokens+=("--port" "$(encode_utf8_b64 "${port}")")
  fi
  if [[ -n "${health_url}" ]]; then
    native_tokens+=("--health-url" "$(encode_utf8_b64 "${health_url}")")
  fi

  if [[ ${#script_args[@]} -gt 0 ]]; then
    local arg
    for arg in "${script_args[@]}"; do
      native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
    done
  fi

  local capture_output=""
  local capture_status=0
  if capture_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    capture_status=0
  else
    capture_status=$?
  fi

  cleanup_wsl_stage_best_effort "${cleanup_local_script}" "${local_script_path}" "${remote_stage_dir}"

  print_capture_output "${capture_output}" "${out_file}"
  return "${capture_status}"
}

cmd_py() {
  [[ $# -ge 2 ]] || die "py requires <target> <remote-script-path> [options] [-- <script-args...>]"
  local target="$1"
  shift

  local script_path
  script_path="$(normalize_remote_path "$1")"
  shift

  local cwd=""
  local python_path=""
  local conda_env=""
  local conda_prefix=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        [[ $# -ge 2 ]] || die "--cwd requires a directory"
        cwd="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --python)
        [[ $# -ge 2 ]] || die "--python requires a path"
        python_path="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --conda-env)
        [[ $# -ge 2 ]] || die "--conda-env requires a name"
        conda_env="$2"
        shift 2
        ;;
      --conda-prefix)
        [[ $# -ge 2 ]] || die "--conda-prefix requires a path"
        conda_prefix="$(normalize_remote_path "$2")"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        die "Unknown py option: $1"
        ;;
    esac
  done

  load_target "${target}"

  local -a native_tokens=("python-b64" "--script" "$(encode_utf8_b64 "${script_path}")")
  if [[ -n "${cwd}" ]]; then
    native_tokens+=("--cwd" "$(encode_utf8_b64 "${cwd}")")
  fi
  if [[ -n "${python_path}" ]]; then
    native_tokens+=("--python" "$(encode_utf8_b64 "${python_path}")")
  fi
  if [[ -n "${conda_env}" ]]; then
    native_tokens+=("--conda-env" "$(encode_utf8_b64 "${conda_env}")")
  fi
  if [[ -n "${conda_prefix}" ]]; then
    native_tokens+=("--conda-prefix" "$(encode_utf8_b64 "${conda_prefix}")")
  fi

  local arg
  for arg in "$@"; do
    native_tokens+=("--arg" "$(encode_utf8_b64 "${arg}")")
  done

  ssh_exec_native_tokens "${native_tokens[@]}"
}

cmd_find() {
  [[ $# -ge 2 ]] || die "find requires <target> <query> [--max <count>]"
  local target="$1"
  shift

  local query="$1"
  shift
  local max_results="100"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max)
        [[ $# -ge 2 ]] || die "--max requires a count"
        max_results="$2"
        shift 2
        ;;
      *)
        die "Unknown find option: $1"
        ;;
    esac
  done

  [[ "${max_results}" =~ ^[0-9]+$ ]] || die "--max must be an unsigned integer"

  load_target "${target}"
  ssh_exec_native_tokens \
    "run-b64" \
    "--file" "$(encode_utf8_b64 "${TARGET_EVERYTHING_ES}")" \
    "--arg" "$(encode_utf8_b64 "-n")" \
    "--arg" "$(encode_utf8_b64 "${max_results}")" \
    "--arg" "$(encode_utf8_b64 "-s")" \
    "--arg" "$(encode_utf8_b64 "${query}")"
}

cmd_probe() {
  [[ $# -ge 1 ]] || die "probe requires <target>"
  local target="$1"
  shift
  local out_file=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        [[ $# -ge 2 ]] || die "--out requires a file path"
        out_file="$2"
        shift 2
        ;;
      *)
        die "Unknown probe option: $1"
        ;;
    esac
  done

  load_target "${target}"
  local probe_output=""

  if probe_output="$(ssh_exec_native_tokens "probe" 2>/dev/null)"; then
    if [[ -n "${out_file}" ]]; then
      printf '%s\n' "${probe_output}" | tee "${out_file}"
      return
    fi

    printf '%s\n' "${probe_output}"
    return
  fi
  local native_status=$?
  if [[ ${native_status} -eq 127 ]]; then
    die "probe now requires ${TARGET_NATIVE_LAUNCHER} or ${TARGET_NATIVE_EXE} on the remote host; legacy direct SSH PowerShell fallback was removed."
  fi
  die "native probe failed on ${TARGET_NAME:-${target}}; refusing to fall back to legacy direct SSH PowerShell"
}

cmd_guard() {
  [[ $# -ge 1 ]] || die "guard requires <target>"
  local target="$1"
  shift
  local out_file=""
  local disable_on_unsafe=1
  local expected_override=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        [[ $# -ge 2 ]] || die "--out requires a file path"
        out_file="$2"
        shift 2
        ;;
      --no-disable)
        disable_on_unsafe=0
        shift
        ;;
      --expected-listen-address)
        [[ $# -ge 2 ]] || die "--expected-listen-address requires an IPv4 address"
        expected_override="$2"
        shift 2
        ;;
      *)
        die "Unknown guard option: $1"
        ;;
    esac
  done

  load_target "${target}"
  local expected
  expected="$(resolve_expected_listen_address "${expected_override}")"
  local -a native_tokens=("guard-sshd" "--expected-listen-address" "${expected}" "--log-path" "${TARGET_GUARD_LOG_PATH}")
  if [[ ${disable_on_unsafe} -eq 0 ]]; then
    native_tokens+=("--no-disable")
  fi

  local guard_output=""
  if guard_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    :
  else
    local status=$?
    printf '%s\n' "${guard_output}"
    return "${status}"
  fi

  if [[ -n "${out_file}" ]]; then
    printf '%s\n' "${guard_output}" | tee "${out_file}"
    return
  fi

  printf '%s\n' "${guard_output}"
}

cmd_repair() {
  [[ $# -ge 1 ]] || die "repair requires <target>"
  local target="$1"
  shift
  local out_file=""
  local expected_override=""
  local force_rewrite=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        [[ $# -ge 2 ]] || die "--out requires a file path"
        out_file="$2"
        shift 2
        ;;
      --expected-listen-address)
        [[ $# -ge 2 ]] || die "--expected-listen-address requires an IPv4 address"
        expected_override="$2"
        shift 2
        ;;
      --force-rewrite)
        force_rewrite=1
        shift
        ;;
      *)
        die "Unknown repair option: $1"
        ;;
    esac
  done

  load_target "${target}"
  local expected
  expected="$(resolve_expected_listen_address "${expected_override}")"
  local -a native_tokens=("repair-sshd" "--expected-listen-address" "${expected}" "--log-path" "${TARGET_REPAIR_LOG_PATH}")
  if [[ ${force_rewrite} -eq 1 ]]; then
    native_tokens+=("--force-rewrite")
  fi

  local repair_output=""
  if repair_output="$(ssh_exec_native_tokens "${native_tokens[@]}")"; then
    :
  else
    local status=$?
    printf '%s\n' "${repair_output}"
    return "${status}"
  fi

  if [[ -n "${out_file}" ]]; then
    printf '%s\n' "${repair_output}" | tee "${out_file}"
    return
  fi

  printf '%s\n' "${repair_output}"
}

sync_policy_to_current_release() {
  local ps_script
  ps_script="$(cat <<EOF
\$ErrorActionPreference = 'Stop'
\$policyPath = '$(remote_cmd_path "${TARGET_POLICY_PATH}")'
\$currentReleaseFile = '$(remote_cmd_path "${TARGET_NATIVE_CURRENT_FILE}")'
if (-not (Test-Path -LiteralPath \$policyPath)) { return }
if (-not (Test-Path -LiteralPath \$currentReleaseFile)) { return }
\$currentRelease = (Get-Content -LiteralPath \$currentReleaseFile -Raw).Trim()
if ([string]::IsNullOrWhiteSpace(\$currentRelease)) { return }
New-Item -ItemType Directory -Path \$currentRelease -Force | Out-Null
Copy-Item -LiteralPath \$policyPath -Destination (Join-Path \$currentRelease 'access-policy.json') -Force
EOF
)"
  ssh_exec_powershell "${ps_script}" >/dev/null
}

cmd_tasks() {
  [[ $# -ge 1 ]] || die "tasks requires <target>"
  local target="$1"
  shift

  local out_file=""
  local prefix=""
  local prefix_set=0
  local -a task_names=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task-name)
        [[ $# -ge 2 ]] || die "--task-name requires a task name"
        task_names+=("$2")
        shift 2
        ;;
      --prefix)
        [[ $# -ge 2 ]] || die "--prefix requires text"
        prefix="$2"
        prefix_set=1
        shift 2
        ;;
      --out)
        [[ $# -ge 2 ]] || die "--out requires a local file path"
        out_file="$2"
        shift 2
        ;;
      *)
        die "Unknown tasks option: $1"
        ;;
    esac
  done

  if [[ ${#task_names[@]} -eq 0 && ${prefix_set} -eq 0 ]]; then
    prefix="CodexRemote"
  elif [[ ${#task_names[@]} -gt 0 && ${prefix_set} -eq 0 ]]; then
    prefix=""
  fi

  load_target "${target}"

  local task_names_json
  if [[ ${#task_names[@]} -gt 0 ]]; then
    task_names_json="$(json_array_from_values "${task_names[@]}")"
  else
    task_names_json="[]"
  fi
  local ps_script
  ps_script="$(cat <<EOF
\$ErrorActionPreference = 'Stop'
\$taskNamesJson = @'
${task_names_json}
'@
\$prefix = @'
$(printf '%s' "${prefix}")
'@
\$taskNames = @()
if (-not [string]::IsNullOrWhiteSpace(\$taskNamesJson)) {
  \$taskNames = @(\$taskNamesJson | ConvertFrom-Json)
}
\$tasks = New-Object System.Collections.Generic.List[object]
foreach (\$taskName in \$taskNames) {
  try {
    \$tasks.Add((Get-ScheduledTask -TaskName \$taskName -ErrorAction Stop))
  } catch {
    \$tasks.Add([PSCustomObject]@{
      TaskName = \$taskName
      TaskPath = '\\'
      Missing = \$true
    })
  }
}
if (-not [string]::IsNullOrWhiteSpace(\$prefix)) {
  Get-ScheduledTask | Where-Object { \$_.TaskName -like ("\$prefix*") } | ForEach-Object {
    \$tasks.Add(\$_)
  }
}
\$results = foreach (\$task in \$tasks | Sort-Object TaskPath, TaskName -Unique) {
  if (\$task.PSObject.Properties.Name -contains 'Missing') {
    [PSCustomObject]@{
      taskName = \$task.TaskName
      taskPath = \$task.TaskPath
      missing = \$true
    }
    continue
  }

  \$taskInfo = Get-ScheduledTaskInfo -TaskName \$task.TaskName -TaskPath \$task.TaskPath
  [PSCustomObject]@{
    taskName = \$task.TaskName
    taskPath = \$task.TaskPath
    state = [string]\$task.State
    enabled = [bool]\$task.Settings.Enabled
    lastRunTime = \$taskInfo.LastRunTime
    nextRunTime = \$taskInfo.NextRunTime
    lastTaskResult = \$taskInfo.LastTaskResult
    actions = @(\$task.Actions | ForEach-Object {
      [PSCustomObject]@{
        execute = \$_.Execute
        arguments = \$_.Arguments
        workingDirectory = \$_.WorkingDirectory
      }
    })
  }
}
\$results | ConvertTo-Json -Compress -Depth 6
EOF
)"

  local tasks_output
  tasks_output="$(ssh_exec_powershell "${ps_script}")"

  if [[ -n "${out_file}" ]]; then
    mkdir -p "$(dirname "${out_file}")"
    printf '%s\n' "${tasks_output}" | tee "${out_file}"
    return
  fi

  printf '%s\n' "${tasks_output}"
}

cmd_policy() {
  [[ $# -ge 1 ]] || die "policy requires <target>"
  local target="$1"
  shift
  local mode=""
  local command_mode=""
  local expected_override=""
  local label=""
  local access_token=""
  local rotate_token=0
  local install_guard=1
  local run_guard=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)
        [[ $# -ge 2 ]] || die "--mode requires private-only or public-with-token"
        mode="$2"
        shift 2
        ;;
      --command-mode)
        [[ $# -ge 2 ]] || die "--command-mode requires standard or argv-only"
        command_mode="$2"
        shift 2
        ;;
      --expected-listen-address)
        [[ $# -ge 2 ]] || die "--expected-listen-address requires an IPv4 address"
        expected_override="$2"
        shift 2
        ;;
      --label)
        [[ $# -ge 2 ]] || die "--label requires text"
        label="$2"
        shift 2
        ;;
      --token)
        [[ $# -ge 2 ]] || die "--token requires a plain access token"
        access_token="$2"
        shift 2
        ;;
      --rotate-token)
        rotate_token=1
        shift
        ;;
      --skip-guard-install)
        install_guard=0
        shift
        ;;
      --no-run-guard)
        run_guard=0
        shift
        ;;
      *)
        die "Unknown policy option: $1"
        ;;
    esac
  done

  load_target "${target}"

  local expected_listen_address
  expected_listen_address="$(resolve_expected_listen_address "${expected_override}")"

  if [[ -z "${mode}" ]]; then
    mode="${TARGET_EXPOSURE_MODE}"
  fi
  if [[ -z "${command_mode}" ]]; then
    command_mode="${TARGET_COMMAND_MODE}"
  fi

  case "${mode}" in
    private-only|public-with-token)
      ;;
    *)
      die "Unsupported policy mode: ${mode}"
      ;;
  esac

  case "${command_mode}" in
    standard|argv-only)
      ;;
    *)
      die "Unsupported command mode: ${command_mode}"
      ;;
  esac

  if [[ ${rotate_token} -eq 1 ]]; then
    access_token="$(generate_access_token)"
    upsert_env_var "${TARGET_ENV_FILE}" "TARGET_ACCESS_TOKEN" "${access_token}"
    TARGET_ACCESS_TOKEN="${access_token}"
  elif [[ -z "${access_token}" ]]; then
    access_token="${TARGET_ACCESS_TOKEN}"
  fi

  if [[ "${mode}" == "public-with-token" && -z "${access_token}" ]]; then
    die "public-with-token mode requires an access token. Set TARGET_ACCESS_TOKEN or pass --token/--rotate-token."
  fi

  if [[ -z "${label}" ]]; then
    label="$(default_policy_label "${mode}" "${access_token}")"
  fi

  upsert_env_var "${TARGET_ENV_FILE}" "TARGET_EXPECTED_LISTEN_ADDRESS" "${expected_listen_address}"
  upsert_env_var "${TARGET_ENV_FILE}" "TARGET_EXPOSURE_MODE" "${mode}"
  upsert_env_var "${TARGET_ENV_FILE}" "TARGET_COMMAND_MODE" "${command_mode}"
  upsert_env_var "${TARGET_ENV_FILE}" "TARGET_POLICY_LABEL" "${label}"
  if [[ -n "${access_token}" ]]; then
    upsert_env_var "${TARGET_ENV_FILE}" "TARGET_ACCESS_TOKEN" "${access_token}"
    TARGET_ACCESS_TOKEN="${access_token}"
  fi

  local policy_file
  policy_file="$(mktemp)"
  write_policy_file "${policy_file}" "${expected_listen_address}" "${mode}" "${command_mode}" "${label}" "${access_token}"

  ensure_remote_parent "${TARGET_POLICY_PATH}"
  scp_to_remote "${policy_file}" "${TARGET_POLICY_PATH}"
  rm -f "${policy_file}"
  sync_policy_to_current_release

  if [[ ${install_guard} -eq 1 ]]; then
    install_guard_tasks "${expected_listen_address}"
  fi

  if [[ ${run_guard} -eq 1 ]]; then
    cmd_guard "${target}"
    return
  fi

  print_ok
}

cmd_put() {
  [[ $# -eq 3 ]] || die "put requires <target> <local-path> <remote-path>"
  load_target "$1"
  local local_path="$2"
  local remote_path
  remote_path="$(normalize_remote_path "$3")"

  [[ -e "${local_path}" ]] || die "Local path not found: ${local_path}"
  if ! remote_path_requires_staged_transfer "${remote_path}"; then
    ensure_remote_parent "${remote_path}"
  fi
  scp_to_remote "${local_path}" "${remote_path}"
  print_ok
}

cmd_get() {
  [[ $# -eq 3 ]] || die "get requires <target> <remote-path> <local-path>"
  load_target "$1"
  local remote_path
  remote_path="$(normalize_remote_path "$2")"
  local local_path="$3"

  mkdir -p "$(dirname "${local_path}")"
  scp_from_remote "${remote_path}" "${local_path}"
  print_ok
}

cmd_deploy() {
  [[ $# -ge 3 ]] || die "deploy requires <target> <local-dir> <remote-dir> [--post <powershell-code>]"
  local target="$1"
  local local_dir="$2"
  local remote_dir
  remote_dir="$(normalize_remote_path "$3")"
  shift 3

  local post_mode=""
  local post_value=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --post)
        [[ $# -ge 2 ]] || die "--post requires PowerShell code"
        post_mode="arg"
        post_value="$2"
        shift 2
        ;;
      --post-file)
        [[ $# -ge 2 ]] || die "--post-file requires a local .ps1 path"
        post_mode="file"
        post_value="$2"
        shift 2
        ;;
      --post-stdin)
        post_mode="stdin"
        post_value=""
        shift
        ;;
      *)
        die "Unknown deploy option: $1"
        ;;
    esac
  done

  local post_code=""
  case "${post_mode}" in
    arg)
      post_code="${post_value}"
      ;;
    file)
      [[ -f "${post_value}" ]] || die "Local file not found: ${post_value}"
      post_code="$(cat "${post_value}")"
      ;;
    stdin)
      post_code="$(cat)"
      ;;
    "")
      ;;
    *)
      die "Unsupported post mode: ${post_mode}"
      ;;
  esac

  [[ -d "${local_dir}" ]] || die "deploy expects a local directory: ${local_dir}"

  load_target "${target}"

  local base_name
  base_name="$(basename "${local_dir}")"
  local deploy_id
  deploy_id="$(date +%Y%m%d_%H%M%S)"
  local stage_parent="${TARGET_STAGE_ROOT}/${deploy_id}"
  local staged_dir="${stage_parent}/${base_name}"

  ensure_remote_dir "${stage_parent}"
  scp_raw -r "${local_dir}" "$(scp_remote_spec "${stage_parent}")"

  local staged_dir_cmd
  staged_dir_cmd="$(remote_cmd_path "${staged_dir}")"
  local stage_parent_cmd
  stage_parent_cmd="$(remote_cmd_path "${stage_parent}")"
  local remote_dir_cmd
  remote_dir_cmd="$(remote_cmd_path "${remote_dir}")"

  local deploy_cmd
  deploy_cmd="$(cat <<EOF
if not exist "${remote_dir_cmd}" mkdir "${remote_dir_cmd}" && xcopy "${staged_dir_cmd}\\*" "${remote_dir_cmd}\\" /E /I /Y /Q >nul && rmdir /s /q "${staged_dir_cmd}" && rmdir /s /q "${stage_parent_cmd}"
EOF
)"

  ssh_exec_cmd "${deploy_cmd}"

  if [[ -n "${post_code}" ]]; then
    ssh_exec_powershell "${post_code}"
    return
  fi

  print_ok
}

cmd_ps_encode() {
  [[ $# -ge 1 ]] || die "ps-encode requires inline PowerShell, --file <local-ps1>, or --stdin"
  local code
  code="$(read_text_source "ps-encode" "$@")"
  printf '%s\n' "$(encode_utf8_b64 "${code}")"
}

cmd_ps_decode() {
  [[ $# -eq 1 ]] || die "ps-decode requires one base64 argument"
  decode_utf8_b64 "$1"
  printf '\n'
}

cmd_ps_check() {
  [[ $# -ge 1 ]] || die "ps-check requires inline PowerShell, --file <local-ps1>, or --stdin"
  local code
  code="$(read_text_source "ps-check" "$@")"

  local wrapped
  wrapped="$(compose_powershell_script "${code}")"
  local body_b64
  body_b64="$(encode_utf8_b64 "${code}")"
  local encoded_command
  encoded_command="$(encode_powershell "${wrapped}")"

  local utf8_roundtrip="mismatch"
  if [[ "$(decode_utf8_b64 "${body_b64}")" == "${code}" ]]; then
    utf8_roundtrip="ok"
  fi

  local body_chars
  body_chars="$(printf '%s' "${code}" | wc -m | tr -d ' ')"
  local wrapped_chars
  wrapped_chars="$(printf '%s' "${wrapped}" | wc -m | tr -d ' ')"
  local body_lines
  body_lines="$(printf '%s' "${code}" | awk 'END { print NR }')"

  printf 'transport=staged-file-via-native-exec-bridge\n'
  printf 'body_chars=%s\n' "${body_chars}"
  printf 'body_lines=%s\n' "${body_lines}"
  printf 'body_utf8_base64_chars=%s\n' "${#body_b64}"
  printf 'wrapped_chars=%s\n' "${wrapped_chars}"
  printf 'encoded_command_chars=%s\n' "${#encoded_command}"
  printf 'utf8_roundtrip=%s\n' "${utf8_roundtrip}"
  printf 'remote_executor_route=%s\n' "WindowsRemoteExecutor.Native.exe exec-file-b64 --kind powershell --file <staged-script>"
}

cmd_update_tools() {
  [[ $# -ge 1 ]] || die "update-tools requires <target>"
  local target="$1"
  shift
  local native_dir=""
  local native_exe=""
  local native_zip=""
  local native_zip_tmp=""
  local everything_dll=""
  local es_exe=""
  local policy_file=""
  local install_guard=0
  local -a local_files=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --native-dir)
        [[ $# -ge 2 ]] || die "--native-dir requires a directory"
        native_dir="$2"
        shift 2
        ;;
      --native-exe)
        [[ $# -ge 2 ]] || die "--native-exe requires a file path"
        native_exe="$2"
        shift 2
        ;;
      --native-zip)
        [[ $# -ge 2 ]] || die "--native-zip requires a local release asset zip"
        native_zip="$2"
        shift 2
        ;;
      --everything-dll)
        [[ $# -ge 2 ]] || die "--everything-dll requires a file path"
        everything_dll="$2"
        shift 2
        ;;
      --es-exe)
        [[ $# -ge 2 ]] || die "--es-exe requires a file path"
        es_exe="$2"
        shift 2
        ;;
      --policy-file)
        [[ $# -ge 2 ]] || die "--policy-file requires a local json file"
        policy_file="$2"
        shift 2
        ;;
      --install-guard)
        install_guard=1
        shift
        ;;
      *)
        die "Unknown update-tools option: $1"
        ;;
    esac
  done

  load_target "${target}"

  local native_source_count=0
  [[ -n "${native_dir}" ]] && native_source_count=$((native_source_count + 1))
  [[ -n "${native_exe}" ]] && native_source_count=$((native_source_count + 1))
  [[ -n "${native_zip}" ]] && native_source_count=$((native_source_count + 1))
  if (( native_source_count > 1 )); then
    die "--native-dir, --native-exe, and --native-zip are mutually exclusive"
  fi

  if [[ -n "${native_zip}" ]]; then
    [[ -f "${native_zip}" ]] || die "Local native release zip not found: ${native_zip}"
    require_cmd unzip
    native_zip_tmp="$(mktemp -d)"
    unzip -q "${native_zip}" -d "${native_zip_tmp}"
    native_dir="${native_zip_tmp}"
  fi

  if [[ -z "${native_dir}" && -z "${native_exe}" ]]; then
    native_dir="$(default_native_publish_dir)"
  fi

  if [[ -n "${native_dir}" ]]; then
    [[ -d "${native_dir}" ]] || die "Local native directory not found: ${native_dir}"
    native_exe="${native_dir}/WindowsRemoteExecutor.Native.exe"
    local native_file
    while IFS= read -r native_file; do
      local_files+=("${native_file}")
    done < <(find "${native_dir}" -maxdepth 1 -type f | sort)
  else
    local_files=("${native_exe}")
  fi

  [[ -f "${native_exe}" ]] || die "Local native exe not found: ${native_exe}"

  if [[ -n "${everything_dll}" ]]; then
    [[ -f "${everything_dll}" ]] || die "Everything64.dll not found: ${everything_dll}"
  fi

  if [[ -z "${es_exe}" ]] && default_local_es_exe >/dev/null 2>&1; then
    es_exe="$(default_local_es_exe)"
  fi

  if [[ -n "${es_exe}" ]]; then
    [[ -f "${es_exe}" ]] || die "es.exe not found: ${es_exe}"
  fi

  if [[ -n "${policy_file}" ]]; then
    [[ -f "${policy_file}" ]] || die "Policy file not found: ${policy_file}"
  fi

  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)"
  local expected_listen_address
  expected_listen_address="$(resolve_expected_listen_address "")"
  local release_dir="${TARGET_NATIVE_RELEASES_DIR}/${stamp}"
  local stage_dir="${TARGET_STAGE_ROOT}/update-tools-${stamp}"
  local stage_payload_dir="${stage_dir}/payload"
  local stage_policy_path="${stage_dir}/access-policy.json"
  local stage_es_path="${stage_dir}/es.exe"
  local stage_launcher_path="${stage_dir}/WindowsRemoteExecutor.cmd"

  ensure_remote_dir "${TARGET_TOOLS_DIR}"
  ensure_remote_dir "${TARGET_NATIVE_RELEASES_DIR}"
  ensure_remote_dir "${stage_dir}"
  ensure_remote_dir "${stage_payload_dir}"

  if [[ -n "${everything_dll}" ]] && [[ " ${local_files[*]} " != *" ${everything_dll} "* ]]; then
    local_files+=("${everything_dll}")
  fi

  local local_path
  for local_path in "${local_files[@]}"; do
    scp_to_remote "${local_path}" "${stage_payload_dir}/$(basename "${local_path}")"
  done

  if [[ -n "${es_exe}" ]]; then
    scp_to_remote "${es_exe}" "${stage_es_path}"
  fi
  if [[ -n "${policy_file}" ]]; then
    scp_to_remote "${policy_file}" "${stage_policy_path}"
  fi

  local launcher_file
  launcher_file="$(mktemp)"
  render_native_launcher "${release_dir}/WindowsRemoteExecutor.Native.exe" "${TARGET_NATIVE_EXE}" >"${launcher_file}"
  scp_to_remote "${launcher_file}" "${stage_launcher_path}"
  rm -f "${launcher_file}"

  local release_dir_cmd
  release_dir_cmd="$(remote_cmd_path "${release_dir}")"
  local stage_dir_cmd
  stage_dir_cmd="$(remote_cmd_path "${stage_dir}")"
  local stage_es_path_cmd
  stage_es_path_cmd="$(remote_cmd_path "${stage_es_path}")"
  local policy_path_cmd
  policy_path_cmd="$(remote_cmd_path "${TARGET_POLICY_PATH}")"
  local es_path_cmd
  es_path_cmd="$(remote_cmd_path "${TARGET_EVERYTHING_ES}")"
  local launcher_path_cmd
  launcher_path_cmd="$(remote_cmd_path "${TARGET_NATIVE_LAUNCHER}")"
  local current_release_file_cmd
  current_release_file_cmd="$(remote_cmd_path "${TARGET_NATIVE_CURRENT_FILE}")"
  local codex_root_cmd
  codex_root_cmd="$(remote_cmd_path "$(dirname "${TARGET_TOOLS_DIR}")")"
  local repair_log_path_cmd
  repair_log_path_cmd="$(remote_cmd_path "${TARGET_REPAIR_LOG_PATH}")"
  local target_user_ps
  target_user_ps="$(printf '%s' "${TARGET_USER}" | sed "s/'/''/g")"

  ssh_exec_cmd "if not exist \"${release_dir_cmd}\" mkdir \"${release_dir_cmd}\""

  for local_path in "${local_files[@]}"; do
    local base_name
    base_name="$(basename "${local_path}")"
    local release_file_path="${release_dir}/${base_name}"
    local release_file_path_cmd
    release_file_path_cmd="$(remote_cmd_path "${release_file_path}")"
    copy_remote_file_bridge "${stage_payload_dir}/${base_name}" "${release_file_path}" >/dev/null
    ssh_exec_cmd "if not exist \"${release_file_path_cmd}\" (echo error: staged file was not copied to release directory: ${base_name} 1>&2 & exit /b 66)"
  done

  ssh_exec_cmd "if not exist \"${release_dir_cmd}\\WindowsRemoteExecutor.Native.exe\" (echo error: staged native exe was not copied to release directory. 1>&2 & exit /b 66)"

  if [[ -n "${policy_file}" ]]; then
    ssh_exec_cmd "if exist \"${policy_path_cmd}\" copy /y \"${policy_path_cmd}\" \"${policy_path_cmd}.bak-${stamp}\" >nul"
    copy_remote_file_bridge "${stage_policy_path}" "${TARGET_POLICY_PATH}" >/dev/null
    copy_remote_file_bridge "${stage_policy_path}" "${release_dir}/access-policy.json" >/dev/null
  else
    if ssh_exec_cmd "if exist \"${policy_path_cmd}\" exit /b 0 else exit /b 1" >/dev/null 2>&1; then
      copy_remote_file_bridge "${TARGET_POLICY_PATH}" "${release_dir}/access-policy.json" >/dev/null
    fi
  fi

  if [[ -n "${es_exe}" ]]; then
    ssh_exec_cmd "(if exist \"${es_path_cmd}\" copy /y \"${es_path_cmd}\" \"${es_path_cmd}.bak-${stamp}\" >nul) && copy /y \"${stage_es_path_cmd}\" \"${es_path_cmd}\" >nul"
  fi

  ssh_exec_cmd "if exist \"${launcher_path_cmd}\" copy /y \"${launcher_path_cmd}\" \"${launcher_path_cmd}.bak-${stamp}\" >nul"
  copy_remote_file_bridge "${stage_launcher_path}" "${TARGET_NATIVE_LAUNCHER}" >/dev/null
  ssh_exec_cmd ">\"${current_release_file_cmd}\" echo ${release_dir_cmd}"

  local task_update_ps
  task_update_ps="$(cat <<EOF
\$ErrorActionPreference = 'Stop'
\$launcherPath = '${launcher_path_cmd}'
\$codexRoot = '${codex_root_cmd}'
\$repairLogPath = '${repair_log_path_cmd}'
\$targetUser = '${target_user_ps}'
\$expectedListenAddress = '${expected_listen_address}'
\$logonTaskName = 'CodexRemote Sshd Repair Logon'
\$startupTaskName = 'CodexRemote Sshd Repair Startup'
\$watchTaskName = 'CodexRemote Sshd Repair Watch'

function Invoke-Required {
  param([string]\$FilePath, [string[]]\$Arguments)
  & \$FilePath @Arguments | Out-Null
  if (\$LASTEXITCODE -ne 0) {
    throw ('{0} failed with exit code {1}: {2}' -f \$FilePath, \$LASTEXITCODE, [string]::Join(' ', \$Arguments))
  }
}

function Invoke-AllowFailure {
  param([string]\$FilePath, [string[]]\$Arguments)
  & \$FilePath @Arguments | Out-Null
  return \$LASTEXITCODE
}

\$repairTaskCommand = ('"{0}" repair-sshd --expected-listen-address {1} --codex-root "{2}" --log-path "{3}"' -f \$launcherPath, \$expectedListenAddress, \$codexRoot, \$repairLogPath)
Invoke-AllowFailure 'schtasks.exe' @('/Delete', '/TN', \$logonTaskName, '/F') | Out-Null
Invoke-AllowFailure 'schtasks.exe' @('/Delete', '/TN', \$startupTaskName, '/F') | Out-Null
Invoke-AllowFailure 'schtasks.exe' @('/Delete', '/TN', \$watchTaskName, '/F') | Out-Null
Invoke-Required 'schtasks.exe' @('/Create', '/TN', \$logonTaskName, '/SC', 'ONLOGON', '/RU', \$targetUser, '/RL', 'HIGHEST', '/TR', \$repairTaskCommand, '/F')
Invoke-Required 'schtasks.exe' @('/Create', '/TN', \$startupTaskName, '/SC', 'ONSTART', '/RU', 'SYSTEM', '/TR', \$repairTaskCommand, '/F')
Invoke-Required 'schtasks.exe' @('/Create', '/TN', \$watchTaskName, '/SC', 'MINUTE', '/MO', '5', '/RU', 'SYSTEM', '/TR', \$repairTaskCommand, '/F')
Invoke-AllowFailure 'schtasks.exe' @('/Run', '/TN', \$watchTaskName) | Out-Null
EOF
)"
  ssh_exec_powershell "${task_update_ps}" >/dev/null
  ssh_exec_cmd "if exist \"${stage_dir_cmd}\" rmdir /s /q \"${stage_dir_cmd}\""

  if [[ ${install_guard} -eq 1 ]]; then
    install_guard_tasks "${expected_listen_address}"
    cleanup_exec_source_best_effort "${native_zip_tmp}"
    cmd_guard "${target}"
    return
  fi

  cleanup_exec_source_best_effort "${native_zip_tmp}"
  print_ok
}

main() {
  require_local_deps

  local subcommand="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "${subcommand}" in
    exec)
      cmd_exec "$@"
      ;;
    exec-capture)
      cmd_exec_capture "$@"
      ;;
    cmd)
      cmd_cmd "$@"
      ;;
    run)
      cmd_run "$@"
      ;;
    capture)
      cmd_capture "$@"
      ;;
    spawn)
      cmd_spawn "$@"
      ;;
    wsl)
      cmd_wsl "$@"
      ;;
    wsl-capture)
      cmd_wsl_capture "$@"
      ;;
    wsl-py)
      cmd_wsl_py "$@"
      ;;
    wsl-py-capture)
      cmd_wsl_py_capture "$@"
      ;;
    wsl-sh)
      cmd_wsl_sh "$@"
      ;;
    wsl-sh-capture)
      cmd_wsl_sh_capture "$@"
      ;;
    wsl-container-sh)
      cmd_wsl_container_sh "$@"
      ;;
    wsl-container-sh-capture)
      cmd_wsl_container_sh_capture "$@"
      ;;
    wsl-resident)
      cmd_wsl_resident "$@"
      ;;
    py)
      cmd_py "$@"
      ;;
    find)
      cmd_find "$@"
      ;;
    probe)
      cmd_probe "$@"
      ;;
    ping)
      cmd_probe "$@"
      ;;
    guard)
      cmd_guard "$@"
      ;;
    repair)
      cmd_repair "$@"
      ;;
    tasks)
      cmd_tasks "$@"
      ;;
    policy)
      cmd_policy "$@"
      ;;
    update-tools)
      cmd_update_tools "$@"
      ;;
    put)
      cmd_put "$@"
      ;;
    get)
      cmd_get "$@"
      ;;
    deploy)
      cmd_deploy "$@"
      ;;
    ps-encode)
      cmd_ps_encode "$@"
      ;;
    ps-decode)
      cmd_ps_decode "$@"
      ;;
    ps-check)
      cmd_ps_check "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      die "Unknown subcommand: ${subcommand}"
      ;;
  esac
}

main "$@"
