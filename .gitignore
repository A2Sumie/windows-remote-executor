.DS_Store
*.zip
# The v6.1.0 bootstrap package is deliberately tracked for new-machine setup:
!releases/**/*.zip
__pycache__/

v6/targets/*.env
!v6/targets/example.env

# v0.3.x release binaries stay local-only (rebuilt from source; large zips)
release-assets/local-fixed/
release-assets/*.zip

# WRE v5 build/release artifacts and any locally-staged native policy (token hash)
v5/build/
v5/release/
v5/native/access-policy.json
v4/build/
v4/release/

# WRE v6 build/release artifacts and locally-staged native policy
v6/build/
v6/release/
v6/native/access-policy.json
